# Input topics (names exactly as the current nodes publish them).
T_TELEMETRY, T_ARM_STATUS, T_GRIPPER, T_IR = "arm/telemetry", "arm/status", "arm/gripper", "arm/ir"
T_CAM_DEMAND, T_CAM_PERCEPTION = "camera/demand", "camera/perception"
