# 5. LIVE MODE
# ============================================================================
def build_state_payload(eng, cond, bus, now_mono, wall_offset):
    """Everything a reader needs in ONE message: state, why, the context behind it and the condition levels."""
    def age(topic):                                   # seconds since a LIVE message; retained copies say nothing
        r = bus.latest(topic)
        return None if r is None or r["retained"] else round(now_mono - r["t"], 2)

    ir, belt = bus.latest(T_IR), bus.latest(T_BELT)
    demand, health = bus.latest(T_CAM_DEMAND), bus.latest(T_HEALTH)
    health_nodes = (health["d"].get("nodes") or {}) if health and isinstance(health["d"], dict) else {}
    blind = eng.state == "NO_DATA"
    return {
        "ts": now_mono + wall_offset,
        "state": eng.state, "detail": eng.detail,
        "since_s": None if eng.since is None else round(now_mono - eng.since, 2),
        "pose": eng.feat["pose"], "gripper": eng.feat["gripper"],
        "arm_moving": eng.feat["moving"], "arm_speed_ticks_s": eng.feat["speed"],
        "off_path": eng.feat["off_path"],
        # NO_DATA = "cannot tell": the levels of the last numbers are not live
        "levels": None if blind else cond.levels(),
        "ir_detected": None if ir is None else bool(ir["d"].get("detected")),
        "belt_running": None if belt is None else abs(belt["d"].get("velocity", 0)) > 50,
        "cycles_ok": eng.cycles_done, "last_cycle_s": eng.last_cycle_s,
        "camera_window": None if demand is None else
            {"window_id": demand["d"].get("window_id"), "cumulative": demand["d"].get("cumulative")},
        "health": {k: v.get("status") for k, v in health_nodes.items()} or None,
        "telemetry_age_s": age(T_TELEMETRY),
    }


def announce(ev, bus, log):
    """Log + publish + print one event (times already converted to wall clock)."""
    log.write(ev)
    hhmmss = datetime.fromtimestamp(ev["t"]).strftime("%H:%M:%S")
    if ev["type"] == "transition":
        bus.publish(T_TRANSITION, ev, qos=1)
        print(f"[{hhmmss}] {ev['from']:<11}-> {ev['to']:<11} ({ev['detail']})", flush=True)
    elif ev["type"] == "cycle":
        bus.publish(T_CYCLE, ev, qos=1)
        extra = ("  " + "; ".join(ev["conditions"])) if ev["conditions"] else ""
        print(f"[{hhmmss}] CYCLE {ev['result']} {ev['seconds']} s -> {ev['dest']}{extra}", flush=True)
    else:
        bus.publish(T_CONDITION, ev, qos=1)
        print(f"[{hhmmss}] CONDITION {ev['text']} (held {ev['held_s']} s, limit {ev['threshold']:g})", flush=True)


def run_live(db_path, th_path):
    # `systemctl stop` sends SIGTERM: turn it into the same clean shutdown as Ctrl+C
    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))
    eng, log, inbox = StateEngine(), TransitionLog(db_path), queue.SimpleQueue()
    th, found, problems = load_thresholds(th_path)
    cond = Conditions(th)
    th_mtime = os.path.getmtime(th_path) if found else None
    bus = Bus(BROKER_HOST, BROKER_PORT, inbox)
    wall_offset = time.time() - time.monotonic()          # wall clock = monotonic + offset
    print(f"[arm-analyzer] up. broker {BROKER_HOST}:{BROKER_PORT}, db {db_path}, thresholds "
          f"{th_path if found else 'built-in defaults (run --write-thresholds or --calibrate to make the file)'}. "
          "Ctrl+C to stop.", flush=True)
    for p in problems:
        print(f"[arm-analyzer] threshold file: {p}", flush=True)
    last_pub = last_sum = last_th = time.monotonic()
    try:
        while True:
            events = []
            # --- drain the inbox (wait at most 50 ms so staleness is still checked) ---
            try:
                item = inbox.get(timeout=0.05)
                while True:
                    kind, t, data = item
                    if kind == "tel":
                        pos, cur, temp = data
                        events += eng.on_sample(t, pos)
                        for ev in cond.update(t, eng.state, cur, temp):
                            eng.note_condition(ev)
                            events.append(ev)
                    elif kind == "grip":                  # G,ERROR latches FAULT until the next G event
                        err = data.get("state") == "ERROR"
                        eng.set_fault(f"gripper ERROR: {data.get('reason') or 'no reason given'}" if err else None)
                    item = inbox.get_nowait()
            except queue.Empty:
                pass
            now = time.monotonic()
            events += eng.on_tick(now)                    # silence -> NO_DATA
            if now - last_th >= 5.0:                      # pick up edits to the threshold file without a restart
                last_th = now
                try:
                    m = os.path.getmtime(th_path)
                    if m != th_mtime:
                        th_mtime = m
                        new, _used, problems = load_thresholds(th_path)
                        cond.set_thresholds(new)
                        print(f"[arm-analyzer] thresholds reloaded from {th_path}", flush=True)
                        for p in problems:
                            print(f"[arm-analyzer] threshold file: {p}", flush=True)
                except OSError:
                    pass
            # --- log + announce every event; event times are converted to wall clock ---
            for ev in events:
                for key in ("t", "start"):
                    if key in ev:
                        ev[key] += wall_offset
                announce(ev, bus, log)
            # --- publish the current state: now on change, else every STATE_REFRESH_S ---
            if events or now - last_pub >= STATE_REFRESH_S:
                last_pub = now
                bus.publish(T_STATE, build_state_payload(eng, cond, bus, now, wall_offset),
                            qos=1 if events else 0, retain=True)
            # --- console heartbeat: never silent (a silent terminal looks like a crash) ---
            if now - last_sum >= SUMMARY_EVERY_S:
                last_sum = now
                tel = bus.latest(T_TELEMETRY)
                bad = [f"{JOINTS[j]}.{m}={lv}" for (j, m), lv in cond.level.items() if lv != "OK"]
                print(f"[{time.strftime('%H:%M:%S')}] state={eng.state}  broker={'up' if bus.connected else 'DOWN'}  "
                      f"arm/telemetry={'none yet' if tel is None else '%.1f s ago' % (now - tel['t'])}  "
                      f"cycles_ok={eng.cycles_done}  levels={'all OK' if not bad else ' '.join(bad)}", flush=True)
    except KeyboardInterrupt:
        print("\n[arm-analyzer] stopping")
    finally:
        bus.close()
        log.close()


