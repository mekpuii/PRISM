# 3. TRANSITION LOGGER  -  SQLite, one row per state change and per cycle
# ============================================================================
class TransitionLog:
    def __init__(self, path):
        self.db = sqlite3.connect(path)
        self.db.execute("PRAGMA journal_mode=WAL")           # readers (dashboards) never block us
        self.db.execute("PRAGMA synchronous=NORMAL")         # a few rows per cycle: no need for a full fsync each
        self.db.executescript("""
            CREATE TABLE IF NOT EXISTS transitions(
                id INTEGER PRIMARY KEY, ts REAL, iso TEXT, from_state TEXT, to_state TEXT,
                detail TEXT, dwell_s REAL, pose TEXT, gripper TEXT, unexpected INTEGER, off_path TEXT);
            CREATE TABLE IF NOT EXISTS cycles(
                id INTEGER PRIMARY KEY, start_ts REAL, start_iso TEXT, end_iso TEXT,
                seconds REAL, dest TEXT, result TEXT, phases TEXT, unexpected TEXT, off_path TEXT, conditions TEXT);
            CREATE TABLE IF NOT EXISTS conditions(
                id INTEGER PRIMARY KEY, ts REAL, iso TEXT, joint TEXT, metric TEXT, state TEXT, level TEXT, prev TEXT,
                value REAL, threshold REAL, held_s REAL);
            CREATE INDEX IF NOT EXISTS ix_tr_ts ON transitions(ts);
            CREATE INDEX IF NOT EXISTS ix_cy_ts ON cycles(start_ts);
            CREATE INDEX IF NOT EXISTS ix_co_ts ON conditions(ts);""")
        cols = [r[1] for r in self.db.execute("PRAGMA table_info(cycles)")]
        if "conditions" not in cols:                         # a db made by an older version of this file
            self.db.execute("ALTER TABLE cycles ADD COLUMN conditions TEXT")
        self.db.commit()

    def write(self, ev):
        """ev carries WALL-clock times (the caller converts)."""
        iso = lambda ts: datetime.fromtimestamp(ts).isoformat(timespec="milliseconds")
        if ev["type"] == "transition":
            self.db.execute("INSERT INTO transitions(ts,iso,from_state,to_state,detail,dwell_s,pose,gripper,"
                            "unexpected,off_path) VALUES(?,?,?,?,?,?,?,?,?,?)",
                            (ev["t"], iso(ev["t"]), ev["from"], ev["to"], ev["detail"],
                             ev["dwell_s"], ev["pose"], ev["gripper"], int(ev["unexpected"]),
                             ",".join(ev["off_path"])))
        elif ev["type"] == "cycle":
            self.db.execute("INSERT INTO cycles(start_ts,start_iso,end_iso,seconds,dest,result,phases,"
                            "unexpected,off_path,conditions) VALUES(?,?,?,?,?,?,?,?,?,?)",
                            (ev["start"], iso(ev["start"]), iso(ev["t"]), ev["seconds"],
                             ev["dest"], ev["result"], json.dumps(ev["phases"]),
                             ",".join(ev["unexpected"]), ",".join(ev["off_path"]), "; ".join(ev["conditions"])))
        else:
            self.db.execute("INSERT INTO conditions(ts,iso,joint,metric,state,level,prev,value,threshold,held_s) "
                            "VALUES(?,?,?,?,?,?,?,?,?,?)",
                            (ev["t"], iso(ev["t"]), ev["joint"], ev["metric"], ev["state"], ev["level"], ev["prev"],
                             ev["value"], ev["threshold"], ev["held_s"]))
        self.db.commit()                                     # a few rows per cycle: commit each

    def close(self):
        self.db.close()


# ============================================================================
# 4. MQTT BUS  -  subscriber + store + publisher
#    Callbacks only STORE or QUEUE data. All decisions happen in the main thread.
# ============================================================================
class Bus:
    def __init__(self, host, port, inbox):
        if mqtt is None:
            raise SystemExit("paho-mqtt is not installed:  pip install paho-mqtt")
        self.inbox = inbox                      # queue of ("tel", t, (pos, cur, temp)) / ("grip", t, event)
        self.lock = threading.Lock()
        self.store = {}                         # topic -> {"t": receive time, "d": payload dict}
        self.arm_online = None                  # from arm/status (None = never seen)
        self.connected = False
        self.c = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2, client_id="arm_analyzer_node")
        self.c.will_set(T_STATUS, json.dumps({"online": False}), qos=1, retain=True)
        self.c.on_connect, self.c.on_disconnect = self._on_connect, self._on_disconnect
        self.c.on_message, self.c.on_connect_fail = self._on_message, self._on_connect_fail
        self.c.connect_async(host, port, keepalive=10)       # never blocks, retries in the background
        self.c.loop_start()

    def _on_connect(self, client, userdata, flags, reason_code, properties):
        print(f"[arm-analyzer] connected to broker: {reason_code}", flush=True)
        self.connected = True
        # (re)subscribe on every connect: subscriptions do not survive a broker restart
        client.subscribe([(t, 1 if t == T_GRIPPER else 0) for t in
                          (T_TELEMETRY, T_ARM_STATUS, T_GRIPPER, T_IR, T_CAM_DEMAND,
                           T_CAM_PERCEPTION, T_HEALTH, T_BELT)])
        client.publish(T_STATUS, json.dumps({"online": True, "ts": time.time()}), qos=1, retain=True)

    def _on_disconnect(self, client, userdata, flags, reason_code, properties):
        self.connected = False
        print("[arm-analyzer] lost the broker", flush=True)

    def _on_connect_fail(self, client, userdata):
        # connect_async retries silently forever; say so, or a wrong MQTT_HOST looks like a hang
        print(f"[arm-analyzer] cannot reach the broker at {BROKER_HOST}:{BROKER_PORT} - retrying", flush=True)

    def _on_message(self, client, userdata, msg):
        now = time.monotonic()
        try:
            data = json.loads(msg.payload)
        except ValueError:
            return                                           # garbage payload: drop
        if msg.topic == T_TELEMETRY:
            parsed = parse_telemetry(data)
            if parsed:
                self.inbox.put(("tel", now, parsed))
        elif msg.topic == T_GRIPPER:
            self.inbox.put(("grip", now, data))
        elif msg.topic == T_ARM_STATUS:
            self.arm_online = bool(data.get("online"))
        with self.lock:                                      # the Data/State store: latest value per topic
            self.store[msg.topic] = {"t": now, "d": data, "retained": bool(msg.retain)}

    def latest(self, topic):
        with self.lock:
            return self.store.get(topic)

    def publish(self, topic, payload, qos=0, retain=False):
        self.c.publish(topic, json.dumps(payload), qos=qos, retain=retain)

    def close(self):
        try:   # wait_for_publish raises if the broker was never reachable; shutdown must still finish
            self.c.publish(T_STATUS, json.dumps({"online": False, "ts": time.time()}),
                           qos=1, retain=True).wait_for_publish(1.0)
        except Exception:
            pass
        self.c.loop_stop()
        self.c.disconnect()


