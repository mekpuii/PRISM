# arm/telemetry carries the servo's current register as COUNTS (STS3215: 6.5 mA per count, same as riff-real /
# autoen_node). If your publisher already sends mA, set this to 1.0. All limits below are in mA.
MA_PER_COUNT = 6.5
HYSTERESIS = 0.10              # a level clears only after the value is 10 % below its limit
TEMP_STALE_S = 30.0            # a temp reading older than this is not used for conditions

# Named poses = joints 1-5 in raw ticks. KEEP IN SYNC with STATES in arm_node.py
# (joint 6 is the gripper and is judged separately below).
POSES = {
    "home":      (2069, 1478, 2172, 3190, 1230),
    "standby":   (2103, 1662, 2357, 3009, 1239),
    "right_bin": (3079, 1932, 1847, 3116, 2081),
    "left_bin":  (1039, 1774, 2071, 3196, 303),
}
BINS = ("left_bin", "right_bin")
ENVELOPE = [(min(p[j] for p in POSES.values()), max(p[j] for p in POSES.values())) for j in range(5)]

# "At a pose" = every joint within this many ticks. Measured on the riff data: the arm rests
# 20-30 ticks off HOME (gravity sag), 4-6 off STANDBY, ~30 off a bin. Poses are >900 ticks
# apart, so 70 cannot confuse two of them.
POSE_TOL_TICKS = 70

# Motion is measured from POSITION CHANGE (path length of joints 1-5 over a short window), not
# from the servo's speed field, because the position unit (ticks) is certain and the speed unit is not.
WINDOW_S = 0.4                 # smoothing window for motion / gripper slope
MOVE_TICKS_PER_S = 120         # above this the arm counts as "moving"

# Gripper (joint 6) in ticks. Measured: open = 2840, fully closed in the air = 2003.
GRIP_OPEN_MIN = 2780           # at or above this the gripper is OPEN
GRIP_CLOSED_MAX = 2100         # at or below this (and still) it is fully CLOSED, nothing between the fingers
GRIP_MOVE_TICKS_PER_S = 120    # slope above this = closing / opening

# One normal cycle visits the states in exactly this order. Any other jump is flagged "unexpected"
# (the state is still committed: it reflects what the arm really does). MOVING / FAULT / NO_DATA
# mean "context lost", so jumps into or out of them are never flagged.
EXPECTED_NEXT = {"IDLE": {"APPROACHING"}, "APPROACHING": {"WAITING"}, "WAITING": {"PICKING"},
                 "PICKING": {"CARRYING"}, "CARRYING": {"PLACING"}, "PLACING": {"RETURNING"},
                 "RETURNING": {"IDLE"}}

# Off-path check: every joint 1-5 should stay inside the range spanned by the four named poses.
# More than this many ticks outside (170 ticks = 15 deg) means the arm left its usual path.
ENVELOPE_MARGIN_TICKS = 170

DEBOUNCE_S = 0.2               # a new state must hold this long before it is committed (backdated)
STALE_S = 1.0                  # no telemetry for this long -> NO_DATA
STATE_REFRESH_S = 1.0          # analyzer/state is re-published at least this often
SUMMARY_EVERY_S = 10.0         # console heartbeat line, so the terminal is never silent

# ============================================================================
# 1. INPUT PARSING  -  one MQTT payload -> plain tuples
# ============================================================================
def parse_telemetry(payload):
    """arm/telemetry -> (pos[6] ticks, cur[6] mA, temp[6] degC), or None if any joint is missing.
    cur / temp entries are None where the payload has none.
    Telemetry is only published when all six servos answered, so 'incomplete' is treated as bad."""
    try:
        joints = payload["joints"]
        pos, cur, temp = [], [], []
        for sid in "123456":
            j = joints[sid]
            if j.get("pos") is None:
                return None
            pos.append(int(j["pos"]))
            c = j.get("cur")
            cur.append(None if c is None else abs(float(c)) * MA_PER_COUNT)    # counts -> mA; sign bit already masked upstream
            t = j.get("temp")
            temp.append(None if t is None else float(t))                        # None until the Mega sends a temperature
        return tuple(pos), tuple(cur), tuple(temp)
    except (KeyError, TypeError, ValueError, AttributeError):
        return None


# ============================================================================
# 2. STATE ENGINE  -  pure logic, no MQTT, no clock. Fed with (time, position) samples.
#    Because it is pure, the SAME code runs live and in --replay, and can be unit-tested.
# ============================================================================
class StateEngine:
    def __init__(self):
        self.state, self.detail, self.since = "NO_DATA", "no telemetry yet", None
        self.cand = None                    # (state, detail, first_seen_t) waiting out the debounce
        self.win = deque()                  # (t, pos6) samples of the last WINDOW_S seconds
        self.last_t = None                  # time of the newest sample
        self.last_settled = None            # last named pose the arm stood still at
        self.fault = None                   # text while the Mega reports G,ERROR
        self.feat = {"pose": None, "moving": False, "gripper": None, "speed": 0.0, "off_path": []}
        self.cycle = None                   # the cycle in progress, or None
        self.cycles_done, self.last_cycle_s = 0, None

    # ---- features: raw positions -> pose / moving / gripper -------------------
    def _features(self):
        w = list(self.win)
        pos = w[-1][1]
        # Which named pose are we at? (None = in between poses)
        best, best_err = None, POSE_TOL_TICKS + 1
        for name, ref in POSES.items():
            err = max(abs(pos[j] - ref[j]) for j in range(5))
            if err < best_err:
                best, best_err = name, err
        # How fast do joints 1-5 move? Path length over the window / window length.
        speed = slope6 = 0.0
        if len(w) >= 2 and w[-1][0] > w[0][0]:
            span = w[-1][0] - w[0][0]
            path = sum(sum(abs(b[1][j] - a[1][j]) for j in range(5)) for a, b in zip(w, w[1:]))
            speed = path / span
            slope6 = (w[-1][1][5] - w[0][1][5]) / span      # signed: negative = closing
        # Gripper status from joint 6 position and slope.
        g = pos[5]
        if slope6 <= -GRIP_MOVE_TICKS_PER_S:
            grip = "CLOSING"
        elif slope6 >= GRIP_MOVE_TICKS_PER_S and g < GRIP_OPEN_MIN:
            grip = "OPENING"
        elif g >= GRIP_OPEN_MIN:
            grip = "OPEN"
        elif g <= GRIP_CLOSED_MAX:
            grip = "CLOSED"
        else:
            grip = "HOLDING"            # still, partly closed: something is between the fingers
        off = [f"J{j + 1}" for j in range(5)
               if not ENVELOPE[j][0] - ENVELOPE_MARGIN_TICKS <= pos[j] <= ENVELOPE[j][1] + ENVELOPE_MARGIN_TICKS]
        self.feat = {"pose": best, "moving": speed > MOVE_TICKS_PER_S, "gripper": grip,
                     "speed": round(speed, 1), "off_path": off}

    # ---- classification: features (+ memory of the last rest pose) -> state ---
    def _classify(self, pos):
        pose, moving, grip = self.feat["pose"], self.feat["moving"], self.feat["gripper"]
        is_open = grip == "OPEN"
        holding = grip in ("CLOSING", "CLOSED", "HOLDING")      # fingers closing / closed / around something
        came = self.last_settled                                # last named pose the arm stood still at
        seen = self.cycle["seen"] if self.cycle else set()      # what this cycle has already gone through
        placed = "PLACING" in seen or came in BINS              # the block has been put down: we head home now
        carrying_ctx = "PICKING" in seen and "PLACING" not in seen
        if pose == "standby":
            if not is_open:
                if moving and grip in ("CLOSED", "HOLDING"):    # grip done and the arm is already leaving
                    return "CARRYING", "leaving pick pose"
                return "PICKING", f"gripper {grip.lower()}"
            return ("APPROACHING", "arriving at pick pose") if moving else ("WAITING", "at pick pose")
        if pose in BINS:
            if not is_open or not moving:
                return "PLACING", f"{pose}, gripper {grip.lower()}"
            return "RETURNING", f"leaving {pose}"
        if pose == "home" and not moving:
            if not is_open and carrying_ctx:                    # the carry pauses at home on its way to a bin
                return "CARRYING", "paused at home, gripper closed"
            return "IDLE", "at home" + ("" if is_open else f", gripper {grip.lower()}")
        if pose == "home" and holding:
            return "CARRYING", "passing home, gripper closed"
        # Anywhere else (between poses, or moving at home): gripper and history decide.
        if holding:
            j1, home1 = pos[0], POSES["home"][0]
            dest = "to left_bin" if j1 < home1 - 150 else "to right_bin" if j1 > home1 + 150 else "via home"
            return "CARRYING", dest
        if grip == "OPENING":                                   # release in progress, arm slightly off its pose
            return ("PLACING", "releasing, arm off pose") if placed else ("MOVING", "gripper opening")
        if placed:
            return "RETURNING", "heading home" if came not in BINS else f"from {came}"
        if came == "home" and not carrying_ctx:
            return "APPROACHING", "from home"
        return "MOVING", "between poses, context unknown"

    # ---- public API -----------------------------------------------------------
    def on_sample(self, t, pos):
        """Feed one telemetry sample. Returns a list of events (transition / cycle dicts)."""
        events = self.on_tick(t)                           # a long gap since the last sample?
        if self.last_t is not None and t <= self.last_t:
            return events                                  # out-of-order / duplicate: ignore
        self.last_t = t
        self.win.append((t, pos))
        while self.win and t - self.win[0][0] > WINDOW_S:
            self.win.popleft()
        self._features()
        state, detail = self._classify(pos)
        if self.fault:
            state, detail = "FAULT", self.fault
        if self.cycle is not None and self.feat["off_path"]:
            self.cycle["off_path"].update(self.feat["off_path"])      # any sample of the cycle counts
        # remember rest poses for the next decision (after classifying this sample)
        if self.feat["pose"] and not self.feat["moving"]:
            self.last_settled = self.feat["pose"]
        return events + self._propose(state, detail, t)

    def on_tick(self, t):
        """Call regularly with the current time: no fresh data -> NO_DATA at once."""
        if self.last_t is not None and t - self.last_t > STALE_S and self.state != "NO_DATA":
            self.win.clear()
            self.cand = None
            return self._commit("NO_DATA", "no telemetry for %.1f s" % (t - self.last_t), self.last_t)
        return []

    def set_fault(self, text):
        """text = reason while the Mega reports G,ERROR; None clears it."""
        self.fault = text

    # ---- debounce + commit ----------------------------------------------------
    def _propose(self, state, detail, t):
        if state == self.state:
            self.detail = detail                           # same state, fresher wording
            self.cand = None
            return []
        if self.state == "NO_DATA":                        # first sample / data is back: no debounce
            return self._commit(state, detail, t)
        if self.cand is None or self.cand[0] != state:
            self.cand = (state, detail, t)                 # start timing the candidate
            return []
        if t - self.cand[2] >= DEBOUNCE_S:                 # held long enough: commit, backdated
            first = self.cand[2]
            self.cand = None
            return self._commit(state, detail, first)
        return []

    def _commit(self, to, detail, since):
        prev, prev_since = self.state, self.since
        dwell = None if prev_since is None else round(since - prev_since, 2)
        unexpected = (prev in EXPECTED_NEXT and to in EXPECTED_NEXT and to not in EXPECTED_NEXT[prev])
        events = [{"type": "transition", "t": since, "from": prev, "to": to, "detail": detail,
                   "dwell_s": dwell, "pose": self.feat["pose"], "gripper": self.feat["gripper"],
                   "unexpected": unexpected, "off_path": list(self.feat["off_path"])}]
        if self.cycle is not None and dwell is not None:
            self.cycle["phases"][prev] += dwell
        # The arm turned round without ever settling at home (RETURNING -> APPROACHING): close the
        # finished cycle right here so two cycles are never glued together, then start the next one.
        if prev == "RETURNING" and to == "APPROACHING" and self.cycle is not None:
            self.cycle["unexpected"].append("RETURNING->APPROACHING")
            events.append(self._finish_cycle(since, aborted=False))
            unexpected = False                              # already booked on the cycle that just ended
            events[0]["unexpected"] = True                  # but the transition itself stays flagged
            self.cycle = self._new_cycle(since)
        # A cycle starts when we leave IDLE, and ends when we are back in IDLE.
        elif prev == "IDLE" and to not in ("IDLE", "NO_DATA", "FAULT"):
            self.cycle = self._new_cycle(since)
        if self.cycle is not None:
            self.cycle["seen"].add(to)
            if unexpected:
                self.cycle["unexpected"].append(f"{prev}->{to}")
            self.cycle["off_path"].update(self.feat["off_path"])
            if to == "PLACING" and self.cycle["dest"] is None and self.feat["pose"] in BINS:
                self.cycle["dest"] = self.feat["pose"]
            if to == "IDLE" or to == "NO_DATA":
                events.append(self._finish_cycle(since, aborted=(to == "NO_DATA")))
        self.state, self.detail, self.since = to, detail, since
        return events

    @staticmethod
    def _new_cycle(start):
        return {"start": start, "phases": defaultdict(float), "seen": set(), "dest": None,
                "unexpected": [], "off_path": set(), "conditions": {}}

    def note_condition(self, ev):
        """A WARN / ALARM that happens during a cycle is booked on it (worst level per joint+metric)."""
        if self.cycle is None or ev["level"] == "OK":
            return
        key = f"{ev['joint']} {ev['metric']}"
        old = self.cycle["conditions"].get(key)
        if old is None or ev["level"] == "ALARM":
            self.cycle["conditions"][key] = (ev["level"], f"{key} {ev['level']}")


    def _finish_cycle(self, end, aborted):
        c, self.cycle = self.cycle, None
        complete = {"PLACING", "RETURNING"} <= c["seen"]          # a missing PICKING shows up as "unexpected"
        conds = sorted(v[1] for v in c["conditions"].values())
        alarm = any(v[0] == "ALARM" for v in c["conditions"].values())
        odd = bool(c["unexpected"] or c["off_path"] or alarm)
        # OK = full sequence in the right order and every joint on its path.
        # ANOMALY = full sequence, but something odd happened on the way (reasons are listed).
        # PARTIAL = back at IDLE without the full sequence.  ABORTED = telemetry vanished mid-cycle.
        result = "ABORTED" if aborted else ("ANOMALY" if odd else "OK") if complete else "PARTIAL"
        seconds = round(end - c["start"], 2)
        if result == "OK":
            self.cycles_done += 1
            self.last_cycle_s = seconds
        return {"type": "cycle", "t": end, "start": c["start"], "seconds": seconds,
                "dest": c["dest"], "result": result, "unexpected": c["unexpected"],
                "off_path": sorted(c["off_path"]), "conditions": conds,
                "phases": {k: round(v, 2) for k, v in c["phases"].items()}}


# ============================================================================
# 2b. THRESHOLDS + CONDITIONS  -  your numbers, per STATE x JOINT, in arm_thresholds.json.
#     Pure logic like the engine (no MQTT, no clock): live, replay, calibrate and the tests share it.
# ============================================================================
JOINTS = ("J1", "J2", "J3", "J4", "J5", "J6")
CURRENT_STATES = ("IDLE", "APPROACHING", "WAITING", "PICKING", "CARRYING", "PLACING", "RETURNING", "MOVING")
# MOVING (and FAULT) have no pose to judge by, so they use the MOVING block: by default the loosest limit of
# any state, joint by joint. That keeps "the arm is somewhere unexpected" from hiding an overcurrent.

# ----------------------------------------------------------------------------
# DEFAULT THRESHOLDS = a STARTING POINT only. Source: your 30-minute riff run (100 cycles, NO block weight beyond
# the cube, arm at the speeds of that run). WARN ~ 1.3 x the p99 of that state/joint, ALARM ~ 1.6 x its max,
# floors 13 mA (WARN) and WARN + 13 mA (ALARM): the current register has only 6.5 mA resolution.
# Each tuple is (warn_mA, alarm_mA) for J1 ... J6. Edit arm_thresholds.json, not this.
# ----------------------------------------------------------------------------
_DEFAULT_ROWS = {
    "IDLE":        [(19.5, 32.5), (13, 26), (13, 65), (26, 39), (13, 26), (13, 26)],
    "APPROACHING": [(13, 26), (13, 26), (13, 26), (26, 39), (13, 26), (13, 26)],
    "WAITING":     [(13, 26), (13, 65), (13, 26), (13, 26), (13, 26), (19.5, 32.5)],
    "PICKING":     [(19.5, 32.5), (58.5, 117), (117, 182), (19.5, 32.5), (13, 26), (32.5, 52)],
    "CARRYING":    [(26, 45.5), (52, 78), (110.5, 188.5), (19.5, 32.5), (26, 39), (13, 26)],
    "PLACING":     [(19.5, 32.5), (97.5, 182), (58.5, 84.5), (13, 26), (19.5, 32.5), (45.5, 58.5)],
    "RETURNING":   [(26, 39), (91, 169), (13, 26), (13, 26), (26, 39), (13, 26)],
}
_DEFAULT_ROWS["MOVING"] = [(max(r[j][0] for r in _DEFAULT_ROWS.values()), max(r[j][1] for r in _DEFAULT_ROWS.values()))
                           for j in range(6)]


def _default_thresholds():
    d = {s: {JOINTS[j]: {"warn_current": w, "alarm_current": a} for j, (w, a) in enumerate(rows)}
         for s, rows in _DEFAULT_ROWS.items()}
    d["TEMPERATURE"] = {"warn": 45, "alarm": 60}          # all joints; add "J3": {"warn": .., "alarm": ..} to override one
    d["HOLD_S"] = {"current": 0.5, "temp": 1.0}           # how long a value must stay over a limit before it counts
    return d


DEFAULT_THRESHOLDS = _default_thresholds()


def _num(x):
    """float(x) for a real number, else None (bool, string, NaN and inf are not limits)."""
    if isinstance(x, bool) or not isinstance(x, (int, float)):
        return None
    return float(x) if x == x and abs(x) != float("inf") else None


def merge_thresholds(user):
    """User dict (FILE schema) merged over the defaults. A key you leave out keeps its default.
    Returns (merged, problems): `problems` lists everything that was ignored and why, so a typo such as "CARYING"
    or "J7" is reported instead of silently doing nothing."""
    merged = json.loads(json.dumps(DEFAULT_THRESHOLDS))                        # deep copy
    problems = []
    if not isinstance(user, dict):
        return merged, ["top level must be an object"]
    for key, row in user.items():
        if key in CURRENT_STATES:
            if not isinstance(row, dict):
                problems.append(f"{key}: must be an object of joints"); continue
            for jn, lim in row.items():
                if jn not in JOINTS or not isinstance(lim, dict):
                    problems.append(f"{key}.{jn}: unknown joint (use J1..J6)"); continue
                for fld, v in lim.items():
                    if fld not in ("warn_current", "alarm_current") or _num(v) is None:
                        problems.append(f"{key}.{jn}.{fld}: ignored (need a number in warn_current / alarm_current)"); continue
                    merged[key][jn][fld] = _num(v)
        elif key == "TEMPERATURE":
            if not isinstance(row, dict):
                problems.append("TEMPERATURE: must be an object"); continue
            for fld, v in row.items():
                if fld in ("warn", "alarm") and _num(v) is not None:
                    merged["TEMPERATURE"][fld] = _num(v)
                elif fld in JOINTS and isinstance(v, dict):
                    for f2, v2 in v.items():
                        if f2 in ("warn", "alarm") and _num(v2) is not None:
                            merged["TEMPERATURE"].setdefault(fld, {})[f2] = _num(v2)
                        else:
                            problems.append(f"TEMPERATURE.{fld}.{f2}: ignored")
                else:
                    problems.append(f"TEMPERATURE.{fld}: ignored")
        elif key == "HOLD_S":
            if not isinstance(row, dict):
                problems.append("HOLD_S: must be an object"); continue
            for fld, v in row.items():
                if fld in ("current", "temp") and _num(v) is not None and _num(v) >= 0:
                    merged["HOLD_S"][fld] = _num(v)
                else:
                    problems.append(f"HOLD_S.{fld}: ignored (need seconds >= 0 in current / temp)")
        else:
            problems.append(f"{key}: unknown key (states: {', '.join(CURRENT_STATES)}, TEMPERATURE, HOLD_S)")
    for s in CURRENT_STATES:                                    # a pair that makes no sense falls back to the defaults
        for jn in JOINTS:
            lim = merged[s][jn]
            if not 0 < lim["warn_current"] < lim["alarm_current"]:
                problems.append(f"{s}.{jn}: need 0 < warn < alarm (got {lim['warn_current']:g} / {lim['alarm_current']:g}): default used")
                merged[s][jn] = dict(DEFAULT_THRESHOLDS[s][jn])
    for scope, lim in [("TEMPERATURE", merged["TEMPERATURE"])] + \
            [(f"TEMPERATURE.{j}", merged["TEMPERATURE"][j]) for j in JOINTS if j in merged["TEMPERATURE"]]:
        w, a = lim.get("warn"), lim.get("alarm")
        if scope != "TEMPERATURE":                              # a per-joint override may give only one of the two
            w = w if w is not None else merged["TEMPERATURE"]["warn"]
            a = a if a is not None else merged["TEMPERATURE"]["alarm"]
        if not 0 < w < a:
            problems.append(f"{scope}: need 0 < warn < alarm: default used")
            if scope == "TEMPERATURE":
                merged["TEMPERATURE"].update(DEFAULT_THRESHOLDS["TEMPERATURE"])
            else:
                del merged["TEMPERATURE"][scope.split(".")[1]]
    return merged, problems


def load_file_schema(path):
    """arm_thresholds.json -> (dict in FILE schema merged over the defaults, file_was_used, problems).
    A missing or unreadable file means the defaults."""
    try:
        with open(path) as f:
            user = json.load(f)
    except (OSError, ValueError) as e:
        merged, _ = merge_thresholds({})
        return merged, False, ([] if isinstance(e, FileNotFoundError) else [f"{path}: {e}"])
    merged, problems = merge_thresholds(user)
    return merged, True, problems


def _convert(file_dict):
    """FILE schema -> the lookup tables Conditions reads."""
    cur = {s: {j: (file_dict[s][j]["warn_current"], file_dict[s][j]["alarm_current"]) for j in JOINTS}
           for s in CURRENT_STATES}
    t = file_dict["TEMPERATURE"]
    temp = {j: ((t.get(j) or {}).get("warn", t["warn"]), (t.get(j) or {}).get("alarm", t["alarm"])) for j in JOINTS}
    return {"current_mA": cur, "temp_C": temp, "hold_s": dict(file_dict["HOLD_S"])}


def load_thresholds(path):
    """-> (lookup tables, file_was_used, problems)"""
    merged, used, problems = load_file_schema(path)
    return _convert(merged), used, problems


class Conditions:
    """Two metrics per joint: 'current' (limits depend on the STATE) and 'temp' (one limit for all states).
    A level (OK / WARN / ALARM) is raised only after the value stays at or above its limit for hold_s, and
    cleared only after it stays HYSTERESIS below it for hold_s: no flicker around a limit.
    The temperature of a joint arrives slowly or not at all: the last good value is used for TEMP_STALE_S."""

    def __init__(self, thresholds):
        self.set_thresholds(thresholds)
        self.level = {(j, m): "OK" for j in range(6) for m in ("current", "temp")}
        self.raw = {k: ("OK", None) for k in self.level}                 # (level the value wants, since t)
        self.last_temp, self.temp_t = [None] * 6, [None] * 6

    def set_thresholds(self, th):
        self.th = th

    @staticmethod
    def _rank(level):
        return {"OK": 0, "WARN": 1, "ALARM": 2}[level]

    def _limits(self, metric, state, j):
        if metric == "temp":
            return self.th["temp_C"][JOINTS[j]]
        row = self.th["current_mA"].get(state) or self.th["current_mA"]["MOVING"]     # MOVING / FAULT use the MOVING block
        return row[JOINTS[j]]

    def levels(self):
        """{"J1": {"current": "OK", "temp": "OK"}, ...} for the state message."""
        return {JOINTS[j]: {"current": self.level[(j, "current")], "temp": self.level[(j, "temp")]} for j in range(6)}

    def update(self, t, state, cur, temp):
        """cur = 6 currents in mA (None = no reading), temp = 6 temperatures in degC (None = no new reading).
        Returns a list of condition events (usually empty)."""
        events = []
        if state == "NO_DATA":
            return events                                       # nothing fresh to judge
        for j in range(6):
            if temp[j] is not None and 0 < temp[j] <= 100:      # 0 / -127 / 255 = a failed or garbled reading
                self.last_temp[j], self.temp_t[j] = temp[j], t
            tv = self.last_temp[j] if self.last_temp[j] is not None and t - self.temp_t[j] <= TEMP_STALE_S else None
            for metric, value in (("current", None if cur[j] is None else abs(cur[j])), ("temp", tv)):
                if value is not None:
                    events += self._one(t, state, j, metric, value)
        return events

    def _one(self, t, state, j, metric, value):
        key = (j, metric)
        warn, alarm = self._limits(metric, state, j)
        # level the number would have WITHOUT hysteresis, then lower it only if we are in the dead band
        want = "ALARM" if value >= alarm else "WARN" if value >= warn else "OK"
        cur = self.level[key]
        if self._rank(want) < self._rank(cur):                  # falling: inside the dead band the old level stays
            if value >= {"ALARM": alarm, "WARN": warn}[cur] * (1.0 - HYSTERESIS):
                want = cur
        raw, since = self.raw[key]
        if raw != want:
            self.raw[key] = (want, t)                           # the wanted level changed: restart its timer
            return []
        hold = self.th["hold_s"]["current" if metric == "current" else "temp"]
        if want != cur and since is not None and t - since >= hold:
            limit = {"ALARM": alarm, "WARN": warn}[want if want != "OK" else cur]
            self.level[key] = want
            unit = "mA" if metric == "current" else "C"
            return [{"type": "condition", "t": since, "joint": JOINTS[j], "metric": metric, "state": state,
                     "level": want, "prev": cur, "value": round(value, 1), "threshold": limit,
                     "held_s": round(t - since, 2),
                     "text": f"{JOINTS[j]} {metric} {value:.0f} {unit} in {state}: {cur} -> {want}"}]
        return []


