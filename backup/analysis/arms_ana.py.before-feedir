# 6. REPLAY MODE  -  run a recorded CSV through the same engine and score it
# ============================================================================
# riff `phase` label -> the engine states that count as correct for it
LABEL_OK = {"IDLE": {"IDLE"}, "FEED": {"IDLE"},                  # the feeder is invisible to telemetry
            "RUN": {"APPROACHING", "WAITING"}, "GRIP_AIR": {"PICKING"},
            "CARRY_HOME": {"CARRYING"}, "CARRY_LEFT": {"CARRYING"}, "CARRY_DOWN": {"CARRYING"},
            "OPEN": {"PLACING"}, "HOME": {"RETURNING"}}
TICKS_PER_DEG = 4096 / 360


def read_riff(path):
    """riff_raw / autoen_raw CSV -> list of (t seconds, pos6 in ticks, phase label, cycle_total, cur6 mA, temp6 degC).
    cur6 / temp6 hold None where the file has a blank (a servo reply was lost)."""
    rows, last = [], [None] * 6
    with open(path, newline="") as f:
        for r in csv.DictReader(f):
            try:
                t = datetime.fromisoformat(r["time"]).timestamp()
            except (ValueError, KeyError):
                continue
            # ~3 % of rows have one blank joint (a servo reply was lost). arm_node keeps the last
            # value of such a joint for up to 1.5 s, so replay does the same instead of dropping the row.
            for i in range(6):
                v = r.get(f"J{i + 1}_position")
                if v not in (None, ""):
                    last[i] = int(round(float(v) * TICKS_PER_DEG))
            if None in last:
                continue                                     # start-up: not all joints seen yet
            def num(col):
                try:
                    return float(r[col]) if r.get(col) not in (None, "") else None
                except ValueError:
                    return None
            rows.append((t, tuple(last), r.get("phase", ""), int(r.get("cycle_total") or 0),
                         tuple(num(f"J{i + 1}_current") for i in range(6)),
                         tuple(num(f"J{i + 1}_temp") for i in range(6))))
    return rows


def pct(v, p):
    v = sorted(v)
    k = (len(v) - 1) * p / 100
    f = int(k)
    c = min(f + 1, len(v) - 1)
    return v[f] + (v[c] - v[f]) * (k - f)


def run_rows(rows, th):
    """The whole pipeline on a recording. Returns (events, per-row engine state)."""
    eng, cond = StateEngine(), Conditions(th)
    events, got = [], []
    for t, pos, _label, _cyc, cur, temp in rows:
        events += eng.on_sample(t, pos)
        for ev in cond.update(t, eng.state, cur, temp):
            eng.note_condition(ev)
            events.append(ev)
        got.append(eng.state)
    return events, got


def run_replay(path, th_path, cycles_csv=None, db_path=None, verbose=False, resample=None):
    rows = read_riff(path)
    if resample:                                             # re-time the recording, e.g. to test 10 Hz
        rows = resample_rows(rows, resample)
    th, _used, problems = load_thresholds(th_path)
    for p in problems:
        print(f"threshold file: {p}")
    events, got = run_rows(rows, th)
    log = TransitionLog(db_path) if db_path else None
    # --- sample-by-sample agreement with the recorded phase labels -------------
    times = [r[0] for r in rows]
    exact = tol = n = 0
    per = defaultdict(lambda: [0, 0])
    confusion = defaultdict(Counter)
    for i, (t, pos, label, cyc, _c, _t) in enumerate(rows):
        if cyc == 0 or label not in LABEL_OK:
            continue                                         # PREPARE / start-up rows have no truth
        n += 1
        ok = got[i] in LABEL_OK[label]
        lo, hi = bisect.bisect_left(times, t - 0.6), bisect.bisect_right(times, t + 0.6)
        near = {rows[j][2] for j in range(lo, hi) if rows[j][2] in LABEL_OK}      # labels within +-0.6 s
        ok_tol = ok or any(got[i] in LABEL_OK[l] for l in near)
        exact += ok
        tol += ok_tol
        per[label][0] += ok_tol
        per[label][1] += 1
        confusion[label][got[i]] += 1
    cycles = [e for e in events if e["type"] == "cycle"]
    if log:
        for e in events:
            log.write(e)
        log.close()
    if verbose:
        for e in events:
            if e["type"] == "transition":
                print(f"{e['t'] - rows[0][0]:8.2f}s  {e['from']:<11}-> {e['to']:<11} {e['detail']}")
    print(f"\nREPLAY {os.path.basename(path)}: {len(rows)} samples, {len(events)} events")
    print(f"agreement with recorded phase labels: exact {100 * exact / n:.1f} %,  "
          f"within +-0.6 s of a label change {100 * tol / n:.1f} %   (n={n})")
    print(f"{'label':<12}{'ok (+-0.6 s)':>13}   states the engine said")
    for label in LABEL_OK:
        if per[label][1]:
            top = ", ".join(f"{s} {c}" for s, c in confusion[label].most_common(3))
            print(f"{label:<12}{100 * per[label][0] / per[label][1]:>11.1f} %   {top}")
    # --- cycles ----------------------------------------------------------------
    by_result = Counter(c["result"] for c in cycles)
    complete = [c for c in cycles if c["result"] in ("OK", "ANOMALY")]
    print(f"\ncycles found: {len(cycles)}  {dict(by_result)}   (recording says {max(r[3] for r in rows)})")

    def riff_no(t):                                          # which riff cycle number was running at time t
        return next((r[3] for r in rows if r[0] >= t + 1.0), 0)     # +1 s: skip the idle tail of the previous cycle

    for c in cycles:
        if c["result"] != "OK":
            why = ", ".join(c["unexpected"][:3]) + ("; " if c["unexpected"] and c["off_path"] else "") + \
                  (f"off path: {','.join(c['off_path'])}" if c["off_path"] else "")
            if c["conditions"]:
                why += ("; " if why else "") + "; ".join(c["conditions"][:3])
            print(f"  cycle {riff_no(c['start']):>3} {c['result']:<8} {c['seconds']:6.2f} s  {why}")
    if complete:
        secs = [c["seconds"] for c in complete]
        print(f"cycle time (leave IDLE -> back in IDLE): mean {sum(secs) / len(secs):.2f} s, "
              f"min {min(secs):.2f}, max {max(secs):.2f}")
        print("destinations:", dict(Counter(c["dest"] for c in complete)))
    if cycles_csv:                                           # compare with the cycle times the riff script logged
        with open(cycles_csv, newline="") as f:
            ref = {int(r["cycle_total"]): float(r["seconds"]) for r in csv.DictReader(f)}
        diffs = [ref[riff_no(c["start"])] - c["seconds"] for c in complete if riff_no(c["start"]) in ref]
        if diffs:
            mean_d = sum(diffs) / len(diffs)
            spread = (sum((d - mean_d) ** 2 for d in diffs) / len(diffs)) ** 0.5
            print(f"vs riff_cycles.csv ({len(ref)} cycles, {len(diffs)} matched): script's time minus ours = "
                  f"{mean_d:.2f} s +- {spread:.2f} s  (the constant part is the FEED step the arm cannot see)")
    conds = [e for e in events if e["type"] == "condition" and e["level"] != "OK"]
    print(f"\nWARN/ALARM events with the current thresholds: {len(conds)}")
    for (jn, m, s, lv), c in sorted(Counter((e["joint"], e["metric"], e["state"], e["level"]) for e in conds).items())[:15]:
        print(f"  {jn} {m:<8}{s:<12}{lv:<6} x{c}")
    return {"exact": exact / n, "tol": tol / n, "cycles": len(complete), "by_result": by_result, "events": events}


def resample_rows(rows, hz):
    """Linear-interpolate positions to a new sample rate (labels, currents, temps = nearest). Proves rate independence."""
    out, step = [], 1.0 / hz
    t = rows[0][0]
    j = 0
    while t <= rows[-1][0]:
        while j + 1 < len(rows) and rows[j + 1][0] < t:
            j += 1
        a, b = rows[j], rows[min(j + 1, len(rows) - 1)]
        f = 0 if b[0] == a[0] else min(1.0, max(0.0, (t - a[0]) / (b[0] - a[0])))
        pos = tuple(int(round(a[1][k] + f * (b[1][k] - a[1][k]))) for k in range(6))
        near = a if f < 0.5 else b
        out.append((t, pos, near[2], near[3], near[4], near[5]))
        t += step
    return out


# ============================================================================
# 6b. --calibrate : look at the thresholds next to the recorded data, change them, test them, save them
# ============================================================================
def reference_stats(path):
    """Run a recording through the engine: per (state, joint) the p99 / max of the current in mA, and per-joint max temp."""
    rows = read_riff(path)
    eng, per = StateEngine(), defaultdict(list)
    tmax = [None] * 6
    for t, pos, _l, _c, cur, temp in rows:
        eng.on_sample(t, pos)
        st = eng.state if eng.state in CURRENT_STATES else "MOVING"
        for j in range(6):
            if cur[j] is not None:
                per[(st, j)].append(abs(cur[j]))
            if temp[j] is not None and 0 < temp[j] <= 100:
                tmax[j] = temp[j] if tmax[j] is None else max(tmax[j], temp[j])
    return {k: (pct(v, 99), max(v)) for k, v in per.items() if v}, tmax, rows


def _cell(lo, hi, w=13):
    return f"{lo:g}/{hi:g}".rjust(w)


def _ceil65(x):
    """Round up to the next multiple of 6.5 mA (the resolution of the current register)."""
    return round(math.ceil(x / 6.5 - 1e-9) * 6.5, 1)


def suggest_for(p99, mx):
    """The rule behind the default table: WARN ~ 1.3 x p99, ALARM ~ 1.6 x max; floors 13 mA and WARN + 13 mA."""
    warn = max(13.0, _ceil65(1.3 * p99))
    alarm = max(_ceil65(1.6 * mx), warn + 13.0)
    return warn, alarm


def _table(th, ref, tmax, full=False):
    print("\n  LIMITS  warn/alarm in mA                                      (state number or name, then joint)")
    print("   #  STATE      " + "".join(j.rjust(13) for j in JOINTS))
    for i, st in enumerate(CURRENT_STATES, 1):
        print(f"  {i:>2}  {st:<11}" + "".join(_cell(th[st][j]["warn_current"], th[st][j]["alarm_current"]) for j in JOINTS))
    if ref and full:
        print("\n  RECORDED  p99/max in mA  (on the --ref file; this is what the limits should sit above)")
        print("      STATE      " + "".join(j.rjust(13) for j in JOINTS))
        for st in CURRENT_STATES:
            cells = "".join(_cell(round(ref[(st, j)][0]), round(ref[(st, j)][1])) if (st, j) in ref else "-".rjust(13)
                            for j in range(6))
            print(f"      {st:<11}{cells}")
    t = th["TEMPERATURE"]
    over = {j: v for j, v in t.items() if j in JOINTS}
    print(f"\n  t  TEMPERATURE  warn {t['warn']:g} / alarm {t['alarm']:g} degC (all joints)"
          + ("".join(f"   {j}: {v.get('warn', t['warn']):g}/{v.get('alarm', t['alarm']):g}" for j, v in over.items())))
    if tmax and any(x is not None for x in tmax):
        print("     recorded max temp: " + "  ".join(f"{JOINTS[j]} {x:g}" for j, x in enumerate(tmax) if x is not None))
    h = th["HOLD_S"]
    print(f"  h  HOLD_S       current {h['current']:g} s, temp {h['temp']:g} s   (seconds over a limit before it counts)")


def _test(th, rows):
    """What would these thresholds have reported on the recording?"""
    if not rows:
        print("  no recording to test on (start with  --calibrate --ref riff_raw.csv)")
        return
    events, _ = run_rows(rows, _convert(th))
    n = Counter((e["joint"], e["metric"], e["state"], e["level"]) for e in events
                if e["type"] == "condition" and e["level"] != "OK")
    cyc = Counter(e["result"] for e in events if e["type"] == "cycle")
    print(f"  on the recording ({rows[-1][0] - rows[0][0]:.0f} s): {sum(n.values())} WARN/ALARM events, cycles {dict(cyc)}")
    for (jn, m, s, lv), c in sorted(n.items())[:30]:
        print(f"    {jn} {m:<8}{s:<12}{lv:<6} x{c}")
    if len(n) > 30:
        print(f"    ... and {len(n) - 30} more kinds")
    if not n:
        print("    none: nothing would have fired")


def _pick_state(tok):
    """'3', 'carrying' or 'carr' -> state name, or None."""
    if tok.isdigit():
        i = int(tok)
        return CURRENT_STATES[i - 1] if 1 <= i <= len(CURRENT_STATES) else None
    hit = [s for s in CURRENT_STATES if s.lower().startswith(tok)]
    return hit[0] if len(hit) == 1 else None


def _pick_joints(tok):
    if tok == "all":
        return list(JOINTS)
    tok = tok[1:] if tok.startswith("j") else tok
    return [f"J{tok}"] if tok in ("1", "2", "3", "4", "5", "6") else None


def run_calibrate(th_path, ref_path):
    th, used, problems = load_file_schema(th_path)
    ref, tmax, rows = {}, [None] * 6, []
    if ref_path:
        ref, tmax, rows = reference_stats(ref_path)
    print(f"[calibrate] {th_path}  ({'loaded' if used else 'not found: starting from the defaults'})")
    for p in problems:
        print(f"            ignored in the file: {p}")
    print("            recorded data: " + (os.path.basename(ref_path) if ref_path else
                                           "none (add --ref riff_raw.csv to see p99/max next to each limit)"))
    help_text = (
        "\ncommands  (<state> = number 1-8, name or its first letters;  <joint> = j1..j6 or all):\n"
        "  <state> <joint> <warn> <alarm>    set both limits            e.g.  carrying j3 120 190\n"
        "  <state> <joint> w <warn>          change only warn           e.g.  5 j3 w 120\n"
        "  <state> <joint> a <alarm>         change only alarm          e.g.  5 j3 a 200\n"
        "  scale <state|all> <factor>        multiply every limit       e.g.  scale all 1.5   (a heavier block)\n"
        "  suggest [<state>|all]             limits from the recording  (needs --ref; not saved until 'save')\n"
        "  t <warn> <alarm>                  temperature, all joints    e.g.  t 45 60\n"
        "  t <joint> <warn> <alarm>          temperature of one joint   e.g.  t j3 40 55\n"
        "  t clear <joint>                   remove that joint's own limit\n"
        "  h <current_s> <temp_s>            hold times in seconds      e.g.  h 0.5 1\n"
        "  test                              what would these limits have reported on the recording?\n"
        "  show     print the tables again      reset   back to the defaults\n"
        "  save     write the file              q       quit (asks if unsaved)\n"
        "  MOVING is used when the arm is between poses and for FAULT.\n")
    print(help_text)
    saved = json.dumps(th, sort_keys=True)
    _table(th, ref, tmax, full=True)
    while True:
        try:
            line = input("\ncalibrate> ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            line = "q"
        p = line.split()
        if not p:
            continue
        try:
            if p[0] in ("q", "quit", "exit"):
                if json.dumps(th, sort_keys=True) != saved and input("unsaved changes - quit anyway? (y/N) ").strip().lower() != "y":
                    continue
                return
            elif p[0] in ("show", "s"):
                _table(th, ref, tmax, full=True)
            elif p[0] in ("help", "?"):
                print(help_text)
            elif p[0] == "reset":
                th = json.loads(json.dumps(DEFAULT_THRESHOLDS))
                _table(th, ref, tmax)
            elif p[0] == "test":
                _test(th, rows)
            elif p[0] == "save":
                with open(th_path, "w") as f:
                    json.dump(th, f, indent=2)
                saved = json.dumps(th, sort_keys=True)
                print(f"  saved {th_path}  (a running node reloads it within 5 s)")
            elif p[0] == "h":
                a, b = float(p[1]), float(p[2])
                if min(a, b) < 0:
                    raise ValueError("hold times cannot be negative")
                th["HOLD_S"] = {"current": a, "temp": b}
                _table(th, ref, tmax)
            elif p[0] == "t":
                tt = th["TEMPERATURE"]
                if p[1] == "clear":
                    jn = _pick_joints(p[2])
                    if not jn or jn[0] not in JOINTS or len(jn) != 1:
                        raise ValueError("t clear j1..j6")
                    tt.pop(jn[0], None)
                elif len(p) == 3:
                    w, a = float(p[1]), float(p[2])
                    if not 0 < w < a:
                        raise ValueError("need 0 < warn < alarm")
                    tt["warn"], tt["alarm"] = w, a
                else:
                    jn = _pick_joints(p[1])
                    if not jn or len(jn) != 1:
                        raise ValueError("joint j1..j6")
                    w, a = float(p[2]), float(p[3])
                    if not 0 < w < a:
                        raise ValueError("need 0 < warn < alarm")
                    tt[jn[0]] = {"warn": w, "alarm": a}
                _table(th, ref, tmax)
            elif p[0] == "scale":
                f = float(p[2])
                if not 0.1 <= f <= 10:
                    raise ValueError("factor must be between 0.1 and 10")
                sts = list(CURRENT_STATES) if p[1] == "all" else [_pick_state(p[1])]
                if None in sts:
                    raise ValueError("unknown state")
                for s in sts:
                    for jn in JOINTS:
                        lim = th[s][jn]
                        lim["warn_current"], lim["alarm_current"] = (round(lim["warn_current"] * f, 1),
                                                                     round(lim["alarm_current"] * f, 1))
                _table(th, ref, tmax)
            elif p[0] == "suggest":
                if not ref:
                    raise ValueError("needs a recording:  --calibrate --ref riff_raw.csv")
                arg = p[1] if len(p) > 1 else "all"
                sts = [s for s in CURRENT_STATES if s != "MOVING"] if arg == "all" else [_pick_state(arg)]
                if None in sts:
                    raise ValueError("unknown state")
                for s in sts:
                    for j, jn in enumerate(JOINTS):
                        if (s, j) in ref:
                            w, a = suggest_for(*ref[(s, j)])
                            th[s][jn] = {"warn_current": w, "alarm_current": a}
                if arg == "all":                       # MOVING = the loosest of the others, as in the defaults
                    for jn in JOINTS:
                        th["MOVING"][jn] = {"warn_current": max(th[s][jn]["warn_current"] for s in CURRENT_STATES[:-1]),
                                            "alarm_current": max(th[s][jn]["alarm_current"] for s in CURRENT_STATES[:-1])}
                _table(th, ref, tmax)
                print("  (suggested from the recording: it has no real load. Review, 'test', then 'save')")
            elif _pick_state(p[0]) is not None:
                st = _pick_state(p[0])
                jns = _pick_joints(p[1])
                if jns is None:
                    raise ValueError("joint must be j1..j6 or all")
                for jn in jns:
                    row = dict(th[st][jn])
                    if p[2] == "w":
                        row["warn_current"] = float(p[3])
                    elif p[2] == "a":
                        row["alarm_current"] = float(p[3])
                    else:
                        row["warn_current"], row["alarm_current"] = float(p[2]), float(p[3])
                    if not 0 < row["warn_current"] < row["alarm_current"]:
                        raise ValueError(f"{st} {jn}: need 0 < warn < alarm")
                    th[st][jn] = {k: (int(v) if float(v).is_integer() else v) for k, v in row.items()}
                _table(th, ref, tmax)
            else:
                print("  not a command: type  ?  for help")
        except (IndexError, ValueError) as e:
            print(f"  not changed: {e if str(e) else 'check the command, type  ?  for help'}")


# ============================================================================
# 7. --show : look at what was recorded
# ============================================================================
def show(db_path, n=15):
    db = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)    # read-only: safe while the node runs
    print(f"== last {n} transitions ==")
    for iso, a, b, detail, dwell in db.execute(
            "SELECT iso,from_state,to_state,detail,dwell_s FROM transitions ORDER BY id DESC LIMIT ?", (n,)):
        print(f"{iso[11:23]}  {a:<11}-> {b:<11} after {dwell if dwell is not None else '-'} s   {detail}")
    print(f"\n== last {n} cycles ==")
    for iso, sec, dest, res, cond in db.execute(
            "SELECT start_iso,seconds,dest,result,conditions FROM cycles ORDER BY id DESC LIMIT ?", (n,)):
        print(f"{iso[11:19]}  {sec:6.2f} s  {str(dest):<10} {res:<8} {cond or ''}")
    row = db.execute("SELECT count(*),avg(seconds),min(seconds),max(seconds) FROM cycles WHERE result='OK'").fetchone()
    if row[0]:
        print(f"\n{row[0]} OK cycles: mean {row[1]:.2f} s, min {row[2]:.2f}, max {row[3]:.2f}")
    print(f"\n== last {n} conditions ==")
    for iso, jn, m, s, lv, pv, val, thr in db.execute(
            "SELECT iso,joint,metric,state,level,prev,value,threshold FROM conditions ORDER BY id DESC LIMIT ?", (n,)):
        print(f"{iso[11:23]}  {jn} {m:<8} {s:<11} {pv} -> {lv}   value {val} (limit {thr})")


# ============================================================================
# MAIN
# ============================================================================
def main(argv=None):
    p = argparse.ArgumentParser(description="PRISM arm analyzer v0: machine state, cycles and conditions from arm telemetry")
    p.add_argument("--db", default=DB_FILE, help="SQLite file for transitions, cycles and conditions")
    p.add_argument("--thresholds", default=THRESHOLD_FILE, help="threshold JSON file")
    p.add_argument("--write-thresholds", action="store_true", help="write the default threshold file to edit, then exit")
    p.add_argument("--calibrate", action="store_true", help="interactive: view / change / test / save the thresholds")
    p.add_argument("--ref", metavar="RIFF_RAW_CSV", help="with --calibrate: a recording to show p99/max and to test on")
    p.add_argument("--replay", metavar="RIFF_RAW_CSV", help="offline: score a recorded run, no broker needed")
    p.add_argument("--cycles", metavar="RIFF_CYCLES_CSV", help="with --replay: compare cycle times")
    p.add_argument("--write-db", action="store_true", help="with --replay: also write the db")
    p.add_argument("--verbose", action="store_true", help="with --replay: print every transition")
    p.add_argument("--resample", type=float, metavar="HZ", help="with --replay: re-time the data (e.g. 10)")
    p.add_argument("--show", action="store_true", help="print recent transitions / cycles / conditions and exit")
    a = p.parse_args(argv)
    if a.write_thresholds:
        if os.path.exists(a.thresholds):
            raise SystemExit(f"{a.thresholds} already exists - not overwriting it")
        with open(a.thresholds, "w") as f:
            json.dump(DEFAULT_THRESHOLDS, f, indent=2)
        print(f"wrote {a.thresholds}. Edit it; a running node reloads it within 5 s.")
    elif a.calibrate:
        run_calibrate(a.thresholds, a.ref)
    elif a.show:
        show(a.db)
    elif a.replay:
        run_replay(a.replay, a.thresholds, a.cycles, a.db if a.write_db else None, a.verbose, a.resample)
    else:
        run_live(a.db, a.thresholds)


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python3
"""
autoen_node.py -- PRISM cell node: ARM + CONVEYOR + FEEDER in one program, with a web dashboard that asks for the
parameters and then runs the real pick cycle. (Pi 4 + Arduino Mega 2560.)

Built on riff-real.py (the cycle, the dashboard, the CSV recording are unchanged) and on arm_node.py (the MQTT side:
the same topics, so the Logger, the Health monitor and the Analyzers see this node exactly like the old arm node).

   Browser --HTTP--> autoen_node.py --USB serial--> Mega --> STS3215 x6 / belt motor / feeder servo / IR
                          |
                          +--MQTT--> Mosquitto --> Logger, Health monitor, Analyzer nodes

ONE cycle (riff-real, unchanged):  FEED > TRANSPORT (belt to the IR, arm to Standby) > GRIP > CARRY Home > drop >
RELEASE > HOME > CLEAR.   A "set" = --cycles-per-set cycles, the run = --sets sets.  Put the blocks in the feeder yourself.

HOW YOU USE IT
  python3 autoen_node.py                  opens http://127.0.0.1:8781 and WAITS: nothing moves.
  On the page: set every parameter, tick "arm area is clear", press Start.  Stop = belt coasts, arm holds.
  Command-line options are only the starting values of the page.  (--auto-start skips the page.)
  From another PC:  ssh -L 8781:127.0.0.1:8781 pi@<pi>   then open http://127.0.0.1:8781 on that PC.
  (The page can MOVE THE ROBOT and has no password: it listens on 127.0.0.1 only unless you pass --web-host.)

MQTT PUBLISHED  (broker = MQTT_HOST env var or --mqtt-host; --no-mqtt runs without a broker)
  arm/telemetry   10 Hz QoS0   {"ts","joints":{"1":{"pos","speed","cur","temp"},..."6":{...}}}    raw units like arm_node:
                               pos = ticks, speed = ticks/s, cur = counts (x6.5 = mA), temp = degC (glitch-filtered).
                               Only when all six joints are fresh. A garbled current reading is replaced by the last good one.
  arm/state       retained     {"ts","mode":"auto|hold|lock","phase","cycle","status"}
  arm/status      retained + Last Will                 arm/ir  retained, on change {"raw","detected"}
  arm/gripper     QoS1         {"state":"CLOSING|CLOSED|ERROR","pos","reason"}  on every gripper event
  belt/telemetry  on every Mega sample   {"ts","temp","current","velocity","position","voltage","pwm","ir","fault"}
                               current mA, velocity rpm, position rev: this is what belt_analyzer_node.py subscribes to
  belt/event      QoS1         {"ts","name","args"}  ARRIVED / FEED_DONE / FAULT ... (the feeder shows up here)
  belt/status     retained + Last Will
  autoen/state    retained 1 Hz   run status, phase, set, cycle, drifts, MQTT counters
  autoen/cycle    QoS1         one message per finished cycle {"n","set","result","secs","drop","notes"}

FILES (--log-dir, default riff_logs/): autoen_raw_<time>.csv, autoen_sets_<time>.csv, autoen_cycles_<time>.csv,
  autoen_thresholds_<time>.csv, autoen_tx_<time>.log   -- same columns as riff-real, so the same tools read them.

NOT included (on purpose): the keyboard jog of arm_node.py. Both programs cannot open the Mega at once, and a human
pressing keys during an automatic cycle would fight it. Use arm_node.py when you want to jog the arm by hand.
Not a safety-rated e-stop. Keep clear of the arm.

Known limits of the data (be aware when you set thresholds)
  * The Mega <-> servo link garbles a few % of replies.  Temperature jumps of more than 6 C are held back until a
    second reading confirms them; how many were rejected is counted in autoen_sets (temp_glitches).
  * Belt current/power are magnitudes.  With the encoder sign wrong, the belt speed loop runs at full PWM and "rpm"
    will look negative - that is part of the behaviour and is logged as is.
