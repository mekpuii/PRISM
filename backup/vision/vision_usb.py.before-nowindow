def find_camera_device():
    """Path of the USB camera: VISION_CAMERA if set, else the first of CAMERA_BY_ID_GLOBS that is plugged in."""

    if CAMERA_DEVICE:
        return CAMERA_DEVICE
    for pattern in CAMERA_BY_ID_GLOBS:
        found = sorted(p for p in glob.glob(pattern) if "RealSense" not in p)
        if found:
            print(f"[camera] using {found[0]}")
            return found[0]
    raise RuntimeError(
        "USB camera not found (" + ", ".join(CAMERA_BY_ID_GLOBS) + "). Is it plugged in? "
        "Or set VISION_CAMERA=/dev/videoN."
    )


class UsbCamera:
    """
    The USB camera behind the same two calls the RealSense pipeline had: wait_for_frame() and stop().

    A background thread reads the camera all the time and keeps only the NEWEST frame, so the picture
    that is processed is never an old one from a buffer.  wait_for_frame() hands out a new frame at
    most FPS times per second (the camera itself runs at CAMERA_FPS).
    """

    def __init__(self, device):
        self.device = device
        self.cap = cv2.VideoCapture(device, cv2.CAP_V4L2)
        if not self.cap.isOpened():
            raise RuntimeError(f"cannot open {device} (in use by another program?)")
        self.cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*"MJPG"))
        self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, CAPTURE_WIDTH)
        self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, CAPTURE_HEIGHT)
        self.cap.set(cv2.CAP_PROP_FPS, CAMERA_FPS)
        self.cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
        got = (int(self.cap.get(cv2.CAP_PROP_FRAME_WIDTH)), int(self.cap.get(cv2.CAP_PROP_FRAME_HEIGHT)))
        if got != (CAPTURE_WIDTH, CAPTURE_HEIGHT):
            self.cap.release()
            raise RuntimeError(f"camera gives {got[0]}x{got[1]}, not {CAPTURE_WIDTH}x{CAPTURE_HEIGHT}")

        self._cond = threading.Condition()
        self._frame = None
        self._frame_t = None     # wall clock when the newest frame was read from the camera
        self.frame_t = None      # the same for the frame wait_for_frame() handed out last
        self._seq = 0            # number of the newest frame
        self._taken = 0          # number of the last frame handed out
        self._next_time = 0.0    # earliest time of the next hand-out (FPS pacing)
        self._error = None
        self._running = True
        self._thread = threading.Thread(target=self._reader, name="usb-camera", daemon=True)
        self._thread.start()

    def _reader(self):
        failures = 0
        while self._running:
            ok, frame = self.cap.read()
            if not ok or frame is None:
                failures += 1
                if failures >= 30:                       # unplugged / dead: tell wait_for_frame()
                    with self._cond:
                        self._error = "camera stopped delivering frames (unplugged?)"
                        self._cond.notify_all()
                    return
                time.sleep(0.05)
                continue
            failures = 0
            got = time.time()
            if frame.shape[1] != WIDTH or frame.shape[0] != HEIGHT:
                frame = cv2.resize(frame, (WIDTH, HEIGHT), interpolation=cv2.INTER_AREA)
            with self._cond:
                self._frame = frame
                self._frame_t = got
                self._seq += 1
                self._cond.notify_all()

    def wait_for_frame(self, timeout_ms):
        """Newest BGR frame (HxWx3 uint8). Raises RuntimeError on timeout, like the RealSense call did."""

        deadline = time.monotonic() + timeout_ms / 1000.0
        pause = self._next_time - time.monotonic()
        if pause > 0:
            time.sleep(pause)
        with self._cond:
            while self._seq == self._taken and self._error is None:
                left = deadline - time.monotonic()
                if left <= 0:
                    raise RuntimeError(f"Frame didn't arrive within {timeout_ms}")
                self._cond.wait(left)
            if self._seq == self._taken:
                raise RuntimeError(self._error)
            self._taken = self._seq
            frame = self._frame
            self.frame_t = self._frame_t
        now = time.monotonic()
        self._next_time = max(self._next_time + 1.0 / FPS, now - 0.5 / FPS) if self._next_time else now + 1.0 / FPS
        return frame

    def stop(self):
        self._running = False
        self._thread.join(timeout=2.0)
        self.cap.release()


def start_camera():
    """
    Open the USB camera and verify that frames arrive.
    """

    device = find_camera_device()

    print(
        f"\nStarting USB camera {device} at "
        f"{CAPTURE_WIDTH}x{CAPTURE_HEIGHT} -> {WIDTH}x{HEIGHT}, {FPS} FPS (camera {CAMERA_FPS} FPS, MJPG)..."
    )

    # The camera can still be held for a moment by a vision that is stopping, or not be ready yet after boot:
    # try again for CAMERA_OPEN_WAIT_S instead of giving up at once (2026-11-11: a restart lost the camera this way).
    deadline = time.monotonic() + CAMERA_OPEN_WAIT_S
    while True:
        try:
            camera = UsbCamera(device)
            break
        except RuntimeError as exc:
            if time.monotonic() >= deadline:
                raise
            print(f"  camera not free yet ({exc}) - trying again in 1 s", flush=True)
            time.sleep(1.0)

    try:

        for i in range(WARMUP_FRAMES):

            camera.wait_for_frame(
                FRAME_TIMEOUT_MS
            )

            print(
                f"Camera warm-up: "
                f"{i + 1}/{WARMUP_FRAMES}",
                flush=True
            )

    except Exception:

        camera.stop()
        raise

    return camera


