# COLOR DETECTION  (v3: any number of colours, one HSV conversion)
# ============================================================

SCENE_GLARE_V = 250    # V at or above this = burnt out (glare, sunlight, a lamp in the picture)
SCENE_DARK_V = 40      # V below this = too dark to tell colours


def scene_stats(hsv, roi_mask=None):
    """The light on the belt for the orchestrator (scene.py): mean brightness V and saturation S (0-255) and the
    percent of burnt-out and too-dark pixels, all inside the ROI (the belt), so people / the room do not count."""
    v, sat = hsv[:, :, 2], hsv[:, :, 1]
    n = cv2.countNonZero(roi_mask) if roi_mask is not None else v.size
    if not n:
        return {}
    glare = cv2.inRange(v, SCENE_GLARE_V, 255)
    dark = cv2.inRange(v, 0, SCENE_DARK_V - 1)
    if roi_mask is not None:
        glare, dark = cv2.bitwise_and(glare, roi_mask), cv2.bitwise_and(dark, roi_mask)
    return {"v_mean": round(cv2.mean(v, mask=roi_mask)[0], 1), "s_mean": round(cv2.mean(sat, mask=roi_mask)[0], 1),
            "glare_pct": round(100.0 * cv2.countNonZero(glare) / n, 2),
            "dark_pct": round(100.0 * cv2.countNonZero(dark) / n, 2)}


# ============================================================
# EMPTY-BELT MODEL: reflections and changing light  (2026-11-12)
# ============================================================
# Why: a lamp reflecting on the glossy belt is bright and colourless = exactly what "white" is in HSV, so the
# colour test alone counted the reflection as a white cube.  The difference is that the reflection BELONGS TO THE
# EMPTY BELT: it is there, in the same place, with no cube.  So the node learns what the empty belt looks like
# (reflection included) and a pixel may only become a cube if it does NOT look like the empty belt.
#   - the model follows the light: slow changes (sun, clouds, auto-exposure) are absorbed pixel by pixel in ~1-2 s,
#     a change of the whole picture at once (lamp on/off) is taken out as one brightness factor ("gain")
#   - pixels under a cube are not learned (a cube that stops on the belt stays a cube, for BG_HOLD_MAX_S)
#   - when the belt is darker than at calibration the V limits go down with it (needs "belt_v" in the calibration file)
# Limit: a WHITE cube INSIDE a white reflection looks almost like the reflection itself and can be lost there.
# Switch off with --no-background (= the old behaviour).
BG_LEARN_FRAMES = 12        # frames averaged at start-up before anything is detected (2 s at 6 FPS)
BG_RELEARN_FRAMES = 3       # the same after a sudden change of the light
BG_DIFF_ABS = 20            # a pixel differs from the empty belt if a colour channel is off by more than this ...
BG_DIFF_REL = 0.12          # ... plus this fraction of the expected brightness (bright pixels are noisier)
BG_ALPHA_FAST = 0.12        # learning rate per frame where there is no cube (about 1.5 s)
BG_ALPHA_SLOW = 0.01        # ... under cube-coloured pixels that are not a confirmed cube yet (about 17 s)
BG_CUBE_MIN_PX = 30         # a "different from the belt" area with this many cube-coloured pixels is a cube, all of it
BG_HOLD_MAX_S = 300.0       # a confirmed cube that does not move is kept this long, then it becomes background
BG_FLASH_JUMP = 0.35        # this much MORE of the belt "different" than one frame ago = the light changed: relearn
BG_GAIN_LIMITS = (0.4, 2.5)
BG_CUBE_RECT = 0.75         # a cube-coloured area in the freshly learned belt that fills this much of its own
                            # rectangle is a CUBE that was standing on the belt, not a reflection (see release_cubes)
LIGHT_ADAPT_BELOW = 0.85    # belt darker than this x calibration -> lower the V limits of the colours
LIGHT_MIN_V = 40            # ... but never below this (darker than this no colour can be told, see SCENE_DARK_V)
LIGHT_WHITE_S_EXTRA = 60    # white looks more coloured in a dark picture: allow up to this much more S
_BG_OPEN = np.ones((3, 3), np.uint8)
_BG_GROW = np.ones((5, 5), np.uint8)


class BeltBackground:
    """What the EMPTY belt looks like (inside the ROI), learned live.  foreground() -> mask of what is NOT empty belt."""

    def __init__(self, roi_mask=None):
        if roi_mask is not None:
            x, y, w, h = cv2.boundingRect(roi_mask)
            self.roi = roi_mask[y:y + h, x:x + w] > 0
        else:
            x, y, w, h = 0, 0, WIDTH, HEIGHT
            self.roi = np.ones((h, w), dtype=bool)
        self.box = (x, y, w, h)
        self.n_roi = max(1, int(self.roi.sum()))
        self.bg = None                                   # float32 BGR, the empty belt as it should look NOW
        self.learned = 0
        self.need = BG_LEARN_FRAMES
        self.fg = np.zeros((h, w), dtype=bool)
        self.fg_frac = 0.0
        self.held = np.zeros((h, w), dtype=np.float32)   # seconds a pixel has been kept out of the learning
        self.belt_v = None                               # median brightness of the empty belt
        self.relearns = 0
        self._crop = None
        self._ticks = 0
        self.fresh = False                               # True right after a learning: release_cubes() is due

    def release_cubes(self, colors, belt_v_ref=None):
        """
        Cubes that STOOD ON THE BELT while it was learned (node started, or relearned after a light change, with
        cubes on the belt) were learned as "empty belt" and then all shown as "reflection (ignored)"
        (seen live 2026-11-12 03:2x).  A cube is matte plastic: one flat colour with straight edges = it fills its
        own rectangle.  A reflection on the glossy belt is a ragged smear.  So every cube-coloured area of the
        fresh model that is rectangular is painted over with the plain belt colour: it is "not empty belt" from
        the next frame on and becomes a normal cube.  Returns how many were found.
        """
        self.fresh = False
        if self.bg is None:
            return 0
        hsv = cv2.cvtColor(np.clip(self.bg, 0, 255).astype(np.uint8), cv2.COLOR_BGR2HSV)
        light = self.light(belt_v_ref)
        roi8 = self.roi.astype(np.uint8) * 255
        any_colour = np.zeros(self.roi.shape, dtype=np.uint8)
        paint = np.zeros(self.roi.shape, dtype=np.uint8)
        found = 0
        for name in colors.names:
            mask = np.zeros(self.roi.shape, dtype=np.uint8)
            for lo, hi in colors.ranges[name]:
                lo, hi = _range_for_light(lo, hi, light)
                mask = cv2.bitwise_or(mask, cv2.inRange(hsv, lo, hi))
            mask = cv2.morphologyEx(cv2.bitwise_and(mask, roi8), cv2.MORPH_OPEN, _BG_OPEN)
            any_colour = cv2.bitwise_or(any_colour, mask)
            contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
            for c in contours:
                area = cv2.contourArea(c)
                if area < MIN_AREA:
                    continue
                (_, _), (rw, rh), _ = cv2.minAreaRect(c)
                if rw * rh <= 0 or area / (rw * rh) < BG_CUBE_RECT:
                    continue                             # ragged = a reflection: stays part of the empty belt
                cv2.drawContours(paint, [c], -1, 255, cv2.FILLED)
                found += 1
        if found:
            plain = self.roi & (cv2.dilate(any_colour, _BG_GROW) == 0)
            if int(plain.sum()) < 50:
                return 0
            belt = np.median(self.bg[plain], axis=0)
            paint = cv2.dilate(paint, np.ones((9, 9), np.uint8)) > 0     # the blurred edge of the cube too
            paint &= self.roi
            self.bg[paint] = belt
            self.belt_v = float(np.median(self.bg.max(axis=2)[self.roi]))
            # they are on the belt already: not a "third of the belt changed in one frame" (= light change, relearn)
            self.fg = paint
            self.fg_frac = float(paint.sum()) / self.n_roi
        return found

    @property
    def learning(self):
        return self.learned < self.need

    def _relearn(self, crop):
        self.bg, self.learned, self.need = crop.copy(), 1, BG_RELEARN_FRAMES
        self.fg[:] = False
        self.held[:] = 0
        self.fg_frac = 0.0
        self.relearns += 1

    def foreground(self, frame):
        x, y, w, h = self.box
        crop = cv2.GaussianBlur(frame[y:y + h, x:x + w], (5, 5), 0).astype(np.float32)
        self._crop = crop
        full = np.zeros(frame.shape[:2], dtype=np.uint8)

        if self.learning:
            self.bg = crop.copy() if self.bg is None else self.bg + (crop - self.bg) / (self.learned + 1)
            self.learned += 1
            if not self.learning:
                self.belt_v = float(np.median(self.bg.max(axis=2)[self.roi]))
                self.fresh = True
            return full

        # the whole picture brighter / darker than the model (lamp, auto-exposure): one factor, measured where
        # nothing was on the belt a frame ago, and applied to the whole model
        calm = self.roi & ~self.fg
        if int(calm.sum()) >= 0.2 * self.n_roi:
            now_v = float(np.median(crop.max(axis=2)[calm]))
            was_v = float(np.median(self.bg.max(axis=2)[calm]))
            gain = min(BG_GAIN_LIMITS[1], max(BG_GAIN_LIMITS[0], now_v / max(was_v, 1.0)))
            if abs(gain - 1.0) > 0.01:
                self.bg *= gain
                np.clip(self.bg, 0, 255, out=self.bg)

        diff = np.abs(crop - self.bg).max(axis=2)
        fg = (diff > BG_DIFF_ABS + BG_DIFF_REL * self.bg.max(axis=2)) & self.roi
        fg8 = cv2.morphologyEx(fg.astype(np.uint8) * 255, cv2.MORPH_OPEN, _BG_OPEN)
        fg8 = cv2.dilate(fg8, _BG_GROW)
        fg = (fg8 > 0) & self.roi

        frac = float(fg.sum()) / self.n_roi
        if frac - self.fg_frac > BG_FLASH_JUMP:          # cubes cannot cover a third of the belt in one frame
            print(f"[belt] light changed ({100 * frac:.0f}% of the belt different at once): learning the empty belt again")
            self._relearn(crop)
            return full
        self.fg, self.fg_frac = fg, frac
        full[y:y + h, x:x + w] = fg.astype(np.uint8) * 255
        return full

    def update(self, coloured, hold_boxes, dt):
        """Learn this frame.  coloured: full-size mask of the pixels that passed as a cube colour;
        hold_boxes: (u, v, w, h) of the confirmed cubes (their pixels are not learned)."""
        if self.learning or self._crop is None:
            return
        x, y, w, h = self.box
        col8 = coloured[y:y + h, x:x + w]
        col = cv2.dilate(col8, _BG_GROW) > 0
        # The WHOLE object counts, not only its pixels that pass the colour test this frame: parts of a cube sit
        # right at the S / V limits and flicker in and out, and every "out" frame was learned as belt - a white
        # cube that stopped on the belt was eaten away in about 2 s (seen live 2026-11-12 01:14).  So every
        # connected "not empty belt" area that contains cube colour is protected as a whole.
        n_lab, labels = cv2.connectedComponents(self.fg.astype(np.uint8), connectivity=8)
        if n_lab > 1:
            inside = np.bincount(labels[col8 > 0], minlength=n_lab) >= BG_CUBE_MIN_PX
            inside[0] = False
            col |= inside[labels]
        hold = np.zeros((h, w), dtype=bool)
        for u, v, bw, bh in hold_boxes:
            x0, x1 = int(u - bw / 2 - 8 - x), int(u + bw / 2 + 9 - x)
            y0, y1 = int(v - bh / 2 - 8 - y), int(v + bh / 2 + 9 - y)
            hold[max(0, y0):max(0, y1), max(0, x0):max(0, x1)] = True
        hold &= col
        self.held = np.where(hold, self.held + dt, 0.0).astype(np.float32)
        hold &= self.held <= BG_HOLD_MAX_S

        alpha = np.full((h, w), BG_ALPHA_FAST, dtype=np.float32)
        alpha[col] = BG_ALPHA_SLOW
        alpha[hold] = 0.0
        self.bg += alpha[:, :, None] * (self._crop - self.bg)

        self._ticks += 1
        if self._ticks % 6 == 0:
            self.belt_v = float(np.median(self.bg.max(axis=2)[self.roi]))

    def light(self, belt_v_ref):
        """Brightness of the empty belt now / at calibration (1.0 = the same, or unknown)."""
        if not belt_v_ref or self.belt_v is None:
            return 1.0
        return max(0.1, min(3.0, self.belt_v / float(belt_v_ref)))


def _range_for_light(lo, hi, light):
    """The calibrated (lo, hi) HSV box moved for a belt that is darker than at calibration."""
    if light >= LIGHT_ADAPT_BELOW:
        return lo, hi
    lo, hi = np.array(lo).copy(), np.array(hi).copy()
    if lo[2] > LIGHT_MIN_V:
        lo[2] = max(LIGHT_MIN_V, int(lo[2] * light))
    if hi[1] <= 90:                                      # a colourless colour (white): looks more coloured when dark
        hi[1] = min(110, int(hi[1] + LIGHT_WHITE_S_EXTRA * (1.0 - light)))
    return lo, hi


def create_color_masks(frame, colors, roi_mask=None, stats=None, fg_mask=None, light=1.0, raw=None):
    """
    {colour name: mask}.  The frame is converted to HSV ONCE.  A pixel that fits two colours goes to the one that
    comes first in `colors.names` (so masks never overlap and a cube can only be one colour).
    fg_mask (BeltBackground.foreground): only these pixels can be a cube - what looks like the empty belt (a
    reflection!) is dropped.  raw: dict that receives the colour masks BEFORE that, to show what was dropped.
    """

    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
    if stats is not None:
        stats.update(scene_stats(hsv, roi_mask))
    claimed = np.zeros(hsv.shape[:2], dtype=np.uint8)
    masks = {}

    for name in colors.names:
        mask = np.zeros(hsv.shape[:2], dtype=np.uint8)

        for lo, hi in colors.ranges[name]:
            if fg_mask is not None:
                lo, hi = _range_for_light(lo, hi, light)
            mask = cv2.bitwise_or(mask, cv2.inRange(hsv, lo, hi))

        # Conveyor ROI: colour anywhere else (table, boxes, people) is thrown away HERE,
        # before any contour/track exists, so it can never be counted.
        if roi_mask is not None:
            mask = cv2.bitwise_and(mask, roi_mask)

        if fg_mask is not None:
            if raw is not None:
                raw[name] = mask
            mask = cv2.bitwise_and(mask, fg_mask)

        mask = cv2.bitwise_and(mask, cv2.bitwise_not(claimed))
        claimed = cv2.bitwise_or(claimed, mask)

        # OPEN removes small speckles; CLOSE fills small holes inside objects.
        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, MORPH_KERNEL)
        mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, MORPH_KERNEL)

        masks[name] = mask

    return masks


def detect_objects(mask, color_name):
    contours, _ = cv2.findContours(
        mask,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )
 
    detections = []
 
    for contour in contours:
 
        area = cv2.contourArea(contour)
 
        if area < MIN_AREA or area > MAX_AREA:
            continue
 
        x, y, w, h = cv2.boundingRect(contour)
 
        if w <= 0 or h <= 0:
            continue
 
        # cube shape (see CUBE_MIN_H): reflections and glare are too small, too thin or too patchy
        at_exit = x + w / 2 < EXIT_ZONE_U
        if (area < (EXIT_MIN_AREA if at_exit else CUBE_MIN_AREA) or (h < CUBE_MIN_H and not at_exit)
                or not CUBE_ASPECT[0] <= w / h <= CUBE_ASPECT[1] or area / float(w * h) < CUBE_FILL):
            shape_rejected[color_name] = shape_rejected.get(color_name, 0) + 1
            continue
 
        moments = cv2.moments(contour)
 
        if moments["m00"] == 0:
            continue
 
        cx = int(
            moments["m10"] / moments["m00"]
        )
 
        cy = int(
            moments["m01"] / moments["m00"]
        )
 
        detections.append({
            "color": color_name,
            "bbox": (x, y, w, h),
            "cx": cx,
            "cy": cy,
            "area": area,
        })
 
    return detections


