def parse_args():
    parser = argparse.ArgumentParser(description="DELTA vision node (selectable colours, spacing, demand)")
    parser.add_argument("--colors", default=None,
                        help="comma-separated colours to detect, in priority order, e.g. white,red,blue "
                             "(default: the 'enabled' list of vision_calibration.json, else white)")
    parser.add_argument("--list-colors", action="store_true", help="print the available colours and exit")
    parser.add_argument("--belt-axis", choices=("u", "v"), default=None,
                        help="image axis along the belt (u = x, v = y). Default: from calibration, else u")
    parser.add_argument("--belt-dir", type=int, choices=(1, -1), default=None,
                        help="+1 if that coordinate GROWS in the direction of travel, -1 if it shrinks")
    parser.add_argument("--calibrate", action="store_true",
                        help="open the calibration window (ROI, count line, colours, belt direction) and exit")
    parser.add_argument("--no-roi", action="store_true",
                        help="run WITHOUT a conveyor ROI (old behaviour: the colours are counted anywhere in the frame)")
    parser.add_argument("--no-background", action="store_true",
                        help="do NOT learn the empty belt (old behaviour: a reflection on the belt can count as white)")
    return parser.parse_args()


def main():

    args = parse_args()

    if args.list_colors:
        print("Available colours (HSV starting points; re-measure with --calibrate):")
        for name, rngs in COLOR_PRESETS.items():
            print(f"  {name:7s} " + "  +  ".join(f"H{lo[0]}-{hi[0]} S{lo[1]}-{hi[1]} V{lo[2]}-{hi[2]}" for lo, hi in rngs))
        return

    calibration = load_calibration()
    saved = calibration or {}

    names = (
        [c for c in args.colors.split(",")] if args.colors
        else (saved.get("enabled") or ["white"])
    )
    belt_axis, belt_dir = saved.get("belt") or (DEFAULT_BELT_AXIS, DEFAULT_BELT_DIR)
    belt_axis = args.belt_axis or belt_axis
    belt_dir = args.belt_dir or belt_dir

    try:
        colors = ColorSet(names, saved.get("colors"))
    except ValueError as exc:
        print(f"Colour setup error: {exc}")
        return

    if args.calibrate:
        calibrate(colors.names, belt_axis, belt_dir)
        return

    if calibration is None and not args.no_roi:
        print(f"No usable {CALIB_FILE}. Run:  python vision_usb.py --calibrate --colors {','.join(colors.names)}")
        print("(or start with --no-roi to count the colours anywhere in the frame)")
        return

    print("=" * 65)
    print(
        "DELTA - Raspberry Pi 4 Object Perception "
        "+ Spacing + Demand Collection"
    )
    print("=" * 65)

    print(
        "Mode: HSV color detection + "
        "USB camera (no depth) + Kalman"
    )

    print(f"Colours (priority order): {', '.join(colors.names)}")
    print(f"Belt axis: {belt_axis}   direction: {belt_dir:+d}")

    print(
        f"Camera streams: "
        f"{WIDTH}x{HEIGHT} at {FPS} FPS"
    )

    print(
        f"Demand window: "
        f"{DATA_COLLECTION_SECONDS} seconds"
    )

    print(
        f"Data sample interval: "
        f"{DATA_SAMPLE_INTERVAL} seconds"
    )

    print(
        f"History file: {HISTORY_CSV}"
    )

    print(
        f"Summary file: {SUMMARY_CSV}"
    )

    print("Press ESC or Q to exit.")

    print("=" * 65)

    # --------------------------------------------------------
    # Initialize data files
    # --------------------------------------------------------

    initialize_csv_files()

    # --------------------------------------------------------
    # Start camera
    # --------------------------------------------------------

    pipeline = None

    try:

        pipeline = start_camera()

    except Exception as exc:

        print(
            "\nERROR: the USB camera did not deliver "
            "frames."
        )

        print(f"Details: {exc}")

        print(
            "\nCheck that the camera is plugged in and that no other "
            "program (ffplay, VLC, another vision node) has it open, "
            "then try again."
        )

        traceback.print_exc()

        return

    # --------------------------------------------------------
    # Tracking state
    # --------------------------------------------------------

    # Connect to the broker only after the camera started successfully.
    # Non-blocking: if the broker is down, vision + CSV logging still run.
    bridge = MqttBridge(MQTT_HOST, MQTT_PORT, colors.names, belt_axis, belt_dir)
    last_perception_pub = 0.0
    last_jpeg_pub = 0.0

    roi_mask = build_roi_mask(calibration["roi"]) if calibration else None
    count_line = calibration["line"] if calibration else None

    # USB camera: no depth and no factory intrinsics -> spacing in pixels only, everything else still works
    print("[spacing] USB camera has no depth; gaps will be in pixels only")
    intr = None

    if calibration:
        apply_shape(calibration.get("shape"))
        apply_camera_controls(getattr(pipeline, "device", None), calibration.get("camera"))
    try:
        calib_mtime = os.path.getmtime(CALIB_FILE)
    except OSError:
        calib_mtime = None
    last_calib_check = time.monotonic()
    last_raw_pub = 0.0

    belt_v_ref = calibration.get("belt_v") if calibration else None
    proc = FrameProcessor(colors, roi_mask, count_line, intr, belt_axis, belt_dir,
                          use_background=not args.no_background, belt_v_ref=belt_v_ref)
    if args.no_background:
        print("[belt] empty-belt model OFF (--no-background): reflections can count as white")
    else:
        print("[belt] learning the empty belt (reflections are ignored)"
              + (f"; belt brightness at calibration V={belt_v_ref:.0f}" if belt_v_ref
                 else "; no belt_v in the calibration file -> no adaptation to a darker belt (re-save --calibrate)"))

    # --------------------------------------------------------
    # Demand collection state
    # --------------------------------------------------------

    window_id = 1

    window_start_time = time.monotonic()

    last_sample_time = window_start_time

    # --------------------------------------------------------
    # FPS
    # --------------------------------------------------------

    previous_time = time.monotonic()
    fps_display = 0.0

    try:

        while True:

            # =================================================
            # GET FRAME
            # =================================================

            try:

                color_image = pipeline.wait_for_frame(
                    FRAME_TIMEOUT_MS
                )
                frame_got = time.time()

            except RuntimeError as exc:

                print(
                    f"\nFrame timeout/error: {exc}"
                )

                print(
                    "No new frames arrived within "
                    "the configured timeout."
                )

                break

            # =================================================
            # TIME / FPS
            # =================================================

            current_time = time.monotonic()

            dt = current_time - previous_time

            previous_time = current_time

            if dt > 0:

                instant_fps = 1.0 / dt

                fps_display = (
                    0.9 * fps_display
                    + 0.1 * instant_fps
                    if fps_display > 0
                    else instant_fps
                )

            # =================================================
            # DETECT, TRACK, COUNT  (FrameProcessor)
            # =================================================

            depth_metres = None                    # USB camera: no depth

            # the USB camera has no clock of its own: ts_frame = when the reader thread got the frame (host clock)
            frame_info = {
                "ts_got": round(frame_got, 3),
                "ts_frame": round(pipeline.frame_t or frame_got, 3),
                "ts_domain": "host_read",
            }

            detections, detected_track_ids, masks = proc.process(
                color_image, depth_metres, current_time, dt
            )

            gaps = proc.gaps()

            # =================================================
            # PUBLISH LIVE PERCEPTION (2 Hz)
            # =================================================

            if (
                current_time - last_perception_pub
                >= PERCEPTION_PUBLISH_INTERVAL
            ):
                bridge.publish_perception(
                    fps_display,
                    live_tracks(proc.tracks),
                    gaps,
                    frame_info,
                    proc.scene
                )
                last_perception_pub = current_time

            # =================================================
            # DEMAND DATA SAMPLING
            # =================================================

            elapsed_window = (
                current_time
                - window_start_time
            )

            elapsed_sample = (
                current_time
                - last_sample_time
            )

            # ------------------------------------------------
            # Save every 10 seconds
            # ------------------------------------------------

            if (
                elapsed_sample
                >= DATA_SAMPLE_INTERVAL
            ):

                save_history_sample(
                    window_id=window_id,
                    elapsed_seconds=elapsed_window,
                    interval_seconds=DATA_SAMPLE_INTERVAL,
                    count=proc.interval_count,
                    cumulative=proc.window_count,
                    by_color=proc.interval_by_color,
                )

                print(
                    f"[DATA] Window {window_id} | "
                    f"{elapsed_window:6.1f}s | "
                    f"+{proc.interval_count} {dict(proc.interval_by_color)} "
                    f"(total {proc.window_count})"
                )

                # Send the same sample to the broker (CSV stays as backup).
                bridge.publish_demand(
                    window_id,
                    elapsed_window,
                    DATA_SAMPLE_INTERVAL,
                    proc.interval_count,
                    proc.window_count,
                    proc.interval_by_color,
                )

                # Reset interval counter.
                proc.reset_interval()

                last_sample_time = current_time

            # =================================================
            # FINISH 3-MINUTE WINDOW
            # =================================================

            if (
                elapsed_window
                >= DATA_COLLECTION_SECONDS
            ):

                # Objects counted after the last 10 s sample would otherwise be in the
                # window total but in no sample. Publish that tail as its own sample.
                tail_seconds = current_time - last_sample_time   # fresh: 0 if a sample just fired

                if tail_seconds >= 0.5:

                    save_history_sample(
                        window_id=window_id,
                        elapsed_seconds=elapsed_window,
                        interval_seconds=round(tail_seconds),
                        count=proc.interval_count,
                        cumulative=proc.window_count,
                        by_color=proc.interval_by_color,
                    )

                    bridge.publish_demand(
                        window_id,
                        elapsed_window,
                        round(tail_seconds),
                        proc.interval_count,
                        proc.window_count,
                        proc.interval_by_color,
                    )

                window_end_time = current_time

                save_window_summary(
                    window_id=window_id,
                    window_start=window_start_time,
                    window_end=window_end_time,
                    total=proc.window_count,
                    by_color=proc.window_by_color,
                )

                print("\n" + "-" * 65)

                print(
                    f"3-MINUTE WINDOW #{window_id} COMPLETE"
                )

                print(
                    f"Objects : {proc.window_count}   by colour: {dict(proc.window_by_color)}"
                )

                print(
                    f"Saved to: {SUMMARY_CSV}"
                )

                bridge.publish_window(
                    window_id,
                    elapsed_window,
                    proc.window_count,
                    proc.window_by_color,
                )

                print("-" * 65 + "\n")

                # ------------------------------------------------
                # Start a NEW 3-minute window.
                # ------------------------------------------------

                window_id += 1

                window_start_time = current_time

                last_sample_time = current_time

                proc.reset_window()

            # =================================================
            # DRAW
            # =================================================

            # the dashboard's Calibrate page: the plain picture, and a saved calibration file taken over at once
            if bridge.raw_until > current_time and current_time - last_raw_pub >= 1.0 / RAW_HZ:
                bridge.publish_raw(color_image)
                last_raw_pub = current_time
            if current_time - last_calib_check >= CALIB_CHECK_S:
                last_calib_check = current_time
                try:
                    mt = os.path.getmtime(CALIB_FILE)
                except OSError:
                    mt = calib_mtime
                if mt != calib_mtime:
                    calib_mtime = mt
                    new_cal = load_calibration()
                    if new_cal is None:
                        print("[calibration] the new file is not usable - keeping the old values")
                    else:
                        try:
                            colors.ranges = ColorSet(colors.names, new_cal.get("colors")).ranges
                            proc.belt_v_ref = new_cal.get("belt_v")
                            apply_shape(new_cal.get("shape"))
                            apply_camera_controls(getattr(pipeline, "device", None), new_cal.get("camera"))
                            print("[calibration] reloaded from the dashboard: "
                                  + ", ".join(f"{n} {[[lo.tolist(), hi.tolist()] for lo, hi in colors.ranges[n]]}"
                                              for n in colors.names)
                                  + (f"; belt V={proc.belt_v_ref:.0f}" if proc.belt_v_ref else ""))
                        except ValueError as exc:
                            print(f"[calibration] reload refused: {exc}")

            annotated = color_image.copy()

            for detection in detections:

                draw_detection_box(
                    annotated,
                    detection
                )

            for track_id, track in proc.tracks.items():

                draw_track(
                    annotated,
                    track,
                    track_id in detected_track_ids
                )

            draw_gaps(annotated, proc.tracks, gaps)

            # what was dropped as "empty belt": grey outline, so it is visible that it was seen AND ignored
            for contour in proc.reflections:
                cv2.drawContours(annotated, [contour], -1, (170, 170, 170), 1)
                rx, ry, _rw, _rh = cv2.boundingRect(contour)
                cv2.putText(annotated, "reflection (ignored)", (rx + 4, ry + 14),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.4, (170, 170, 170), 1, cv2.LINE_AA)
            if proc.background is not None and proc.background.learning:
                cv2.putText(annotated, "learning the empty belt...", (WIDTH // 2 - 110, HEIGHT - 12),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 255, 255), 1, cv2.LINE_AA)

            if calibration is not None:
                cv2.polylines(annotated, [calibration["roi"]], True, (0, 200, 0), 2)

                if count_line is not None and COUNT_MODE == "line":
                    cv2.line(annotated, tuple(count_line[0]), tuple(count_line[1]), (0, 165, 255), 2)

            # Current window elapsed time.
            display_window_elapsed = (
                current_time
                - window_start_time
            )

            draw_dashboard(
                annotated,
                proc.tracks,
                proc.total_unique_objects,
                fps_display,
                window_id,
                display_window_elapsed,
                proc.window_count,
                proc.window_by_color,
                colors.names,
            )

            if current_time - last_jpeg_pub >= 1.0 / JPEG_HZ:
                bridge.publish_jpeg(annotated)
                last_jpeg_pub = current_time

            # =================================================
            # DISPLAY
            # =================================================

            if SHOW_MASKS:

                for name, mask in masks.items():
                    cv2.imshow(f"Mask {name}", mask)

            cv2.imshow(
                WINDOW_NAME,
                annotated
            )

            key = cv2.waitKey(1) & 0xFF

            if key in (
                27,
                ord("q"),
                ord("Q")
            ):
                break

    except KeyboardInterrupt:

        print("\nStopping...")

    except Exception:

        print(
            "\nRuntime error during processing:"
        )

        traceback.print_exc()

    finally:

        print(
            "\nStopping camera..."
        )

        if pipeline is not None:

            try:
                pipeline.stop()

            except Exception as exc:

                print(
                    f"Camera shutdown note: {exc}"
                )

        bridge.close()

        cv2.destroyAllWindows()

        print("Done.")


