+def cmd_calibrate(args, api, ask=default_ask, recorder_factory=None):
+    """No cubes: run the empty belt at every rpm and store the measured rpm in belt_ref.json."""
+    rpms = [float(x) for x in args.rpms.split(",") if x.strip()]
+    for r in rpms:
+        lo, hi = PLAN_LIMITS["rpm"]
+        if not lo <= r <= hi:
+            raise PlanError(f"rpm {r:g} outside {lo:g}..{hi:g}")
+    ref = BeltRef(args.belt_ref)
+    if args.dry_run:
+        print("calibrate:", ", ".join(f"{r:g}" for r in rpms), f"rpm, {args.seconds:g} s each -> {args.belt_ref}")
+        fake = [{"block": i, "repeat": 1, "config_id": i, "label": "cal", "rpm": r, "arm_speed": 1.0, "carry_speed": 1.0,
+                 "n_cycles": 1, "set": {}} for i, r in enumerate(rpms, 1)]
+        args.allow_missing_ref = True
+        return dry_run(api, fake, ref, args)
+    a_sha = sha256_file(args.autoen_path)
+    sess = Session("cal", args.runs_dir, recorder_factory, args.autoen_path, args.note, "none (empty belt)",
+                   extra={"rpms": rpms, "seconds": args.seconds, "belt_ref_file": args.belt_ref})
+    status = "finished"
+    try:
+        start_autoen(api, sess, ask, {})
+        for r in rpms:
+            if ask(f"\nrpm {r:g}: the belt will run EMPTY for {args.seconds:g} s. Belt clear? Enter = run, s = skip, q = quit: "
+                   ).strip().lower() in ("s", "q"):
+                continue
+            task = run_task(api, sess, {"kind": "belt_run", "rpm": r, "seconds": args.seconds, "settle_s": args.settle_s})
+            chk = belt_check(task, None, allow_missing_ref=True)
+            if not chk["ok"]:
+                print(f"  rpm {r:g}: NOT stored - {chk['reason']}")
+                continue
+            e = ref.update(r, task, sess.run_id, a_sha)
+            ref.save()
+            sess.event("belt_ref", e)
+            print(f"  rpm {r:g}: measured {e['rpm_meas_mean']} ± {e['rpm_meas_std']} rpm, {e['belt_W_mean']} W -> stored")
+    except KeyboardInterrupt:
+        status = "interrupted"
+    except (SessionError, ApiError) as e:
+        status = "error"
+        sess.meta["error"] = str(e)
+        print("STOPPED:", e)
+    finally:
+        sess.meta["belt_ref_after"] = ref.data["entries"]
+        if args.stop_at_end:
+            try:
+                api.post("/api/stop")
+            except ApiError:
+                pass
+        sess.close(status)
+    return 0 if status == "finished" else 1
