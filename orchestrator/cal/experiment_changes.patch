+# ---------------------------------------------------------------------- fake autoen
+class FakeAutoen:
+    """status ready -> start -> paused at set boundary; resume runs cycles_per_set scripted cycles, then pauses again."""
+
+    def __init__(self, results=None, belt_rpm=lambda rpm: rpm, clamp=None, error_after=None):
+        self.results = list(results or [])                  # (result, notes) per cycle, popped in order; default OK
+        self.belt_rpm, self.clamp, self.error_after = belt_rpm, clamp, error_after
+        self.posts = []
+        self.lock = threading.Lock()
+        self.st = {"status": "ready", "message": "", "phase": "IDLE", "set": 1, "cycle_total": 0, "cycle_in_set": 0,
+                   "paused": False, "set_boundary": False, "task": None, "cycles": [],
+                   "config": {"rpm": 60.0, "arm_speed": 1.0, "carry_speed": 1.0, "cycles_per_set": 100, "sets": 1,
+                              "pause_before_set": 0, "enable_b": 0, "enable_c": 0, "arrive_timeout": 20.0}}
+        self.sets_run = 0
+        srv = ThreadingHTTPServer(("127.0.0.1", 0), self.handler())
+        threading.Thread(target=srv.serve_forever, daemon=True).start()
+        self.srv, self.url = srv, f"http://127.0.0.1:{srv.server_address[1]}"
+
+    def handler(self):
+        fake = self
+
+        class H(BaseHTTPRequestHandler):
+            def log_message(self, *a):
+                pass
+
+            def reply(self, code, body):
+                data = json.dumps(body).encode()
+                self.send_response(code)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(data)))
+                self.end_headers()
+                self.wfile.write(data)
+
+            def do_GET(self):
+                with fake.lock:
+                    self.reply(200, json.loads(json.dumps(fake.st)))
+
+            def do_POST(self):
+                body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
+                fake.posts.append((self.path, body))
+                try:
+                    self.reply(200, fake.post(self.path, body))
+                except ValueError as e:
+                    self.reply(400, {"error": str(e)})
+        return H
+
+    def set_config(self, cfg):
+        for k, v in cfg.items():
+            if k not in self.st["config"]:
+                raise ValueError(f"unknown setting {k}")
+            if self.clamp and k in self.clamp:
+                v = min(v, self.clamp[k])                  # simulates a setting that does not stick
+            self.st["config"][k] = v
+        return cfg
+
+    def post(self, path, body):
+        with self.lock:
+            st = self.st
+            if path == "/api/start":
+                if st["status"] != "ready":
+                    raise ValueError("cannot start")
+                self.set_config(body.get("config", {}))
+                st.update(status="paused", paused=True, set_boundary=True)
+                return {"started": True}
+            if path == "/api/config":
+                return {"applied": self.set_config(body)}
+            if path == "/api/stop":
+                st.update(status="stopped", paused=False, set_boundary=False, message="stopped by the operator")
+                return {}
+            if path == "/api/task":
+                if st["status"] != "paused":
+                    raise ValueError("tasks only run while paused")
+                tid = (st["task"] or {"id": 0})["id"] + 1
+                meas = self.belt_rpm(body.get("rpm", 0)) if body["kind"] == "belt_run" else 0.0
+                st["task"] = {"id": tid, "status": "done", **body, "arrived": False, "error": None, "t_end": time.time(),
+                              "settle_s": body.get("settle_s", 3.0),
+                              "stats": {"belt_rpm": {"n": 50, "mean": meas, "std": 0.3}, "belt_mA": {"n": 50, "mean": 120.0},
+                                        "belt_W": {"n": 50, "mean": 1.4}, "arm_mA": {"n": 20, "mean": 60.0},
+                                        "arm_W": {"n": 20, "mean": 0.7}}}
+                return {"task": st["task"]}
+            if path == "/api/pause":
+                if st["paused"]:
+                    st.update(paused=False, set_boundary=False, status="running")
+                    threading.Thread(target=self.run_set, daemon=True).start()
+                else:
+                    st["paused"] = True
+                return {}
+        raise ValueError("unknown path")
+
+    def run_set(self):
+        self.sets_run += 1
+        with self.lock:
+            cps = self.st["config"]["cycles_per_set"]
+            self.st["cycle_in_set"] = 0
+        for c in range(1, cps + 1):
+            time.sleep(0.02)
+            with self.lock:
+                st = self.st
+                if self.error_after and self.sets_run == self.error_after[0] and c > self.error_after[1]:
+                    st.update(status="error", message="RuntimeError: 3 failed cycles in a row - stopping")
+                    return
+                res, notes = self.results.pop(0) if self.results else ("OK", "")
+                st["cycle_total"] += 1
+                st["cycle_in_set"] = c
+                st["cycles"] = (st["cycles"] + [{"n": st["cycle_total"], "set": st["set"], "result": res, "secs": 20.0,
+                                                 "notes": notes}])[-12:]
+        with self.lock:
+            self.st.update(set=self.st["set"] + 1, status="paused", paused=True, set_boundary=True)
+
